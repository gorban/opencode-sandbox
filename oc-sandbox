#!/usr/bin/env bash
# oc-sandbox — idempotent setup + launch + teardown for sandboxed OpenCode instances
# (one rootless Podman pod per instance: OpenCode agent + Chromium on your Wayland desktop,
# optional Postgres and docker-in-docker sidecar).
set -euo pipefail

SB="$HOME/opencode-sandbox"            # mounted at /sandbox in every agent
# This script runs on the HOST (and asks for admin rights), so it must never live inside the directory
# that is mounted into the agent containers, or an agent could rewrite it.
SCRIPT_REAL=$(readlink -f "$0"); SCRIPT_DIR=${SCRIPT_REAL%/*}
case $SCRIPT_REAL in
  "$(readlink -f "$SB")"/*)
    echo "Refusing to run: $SCRIPT_REAL is inside the sandbox directory $SB," >&2
    echo "which the agent can write to. Keep the checkout elsewhere (e.g. ~/code/opencode-sandbox)" >&2
    echo "and symlink it into ~/.local/bin. See README.md." >&2
    exit 1 ;;
esac
STATE="${XDG_DATA_HOME:-$HOME/.local/share}/oc-sandbox"
BUILD="$STATE/build"
BIN="$HOME/.local/bin"
UNITS="$HOME/.config/systemd/user"
AGENT_IMG=oc-agent
CHROME_IMG=oc-chromium
DIND_IMG=${OC_DIND_IMAGE:-quay.io/podman/stable:latest}
HOMEVOL=oc-home                        # OpenCode login, sessions, self-updated binary: shared by all instances
CODE_BIN=${OC_CODE_BIN:-/home/linuxbrew/.linuxbrew/bin/code}   # host VS Code (override with OC_CODE_BIN)
BC_BIN=${OC_BCOMPARE_BIN:-/usr/bin/bcompare}                         # host Beyond Compare (override with OC_BCOMPARE_BIN)
AGENT_MEM=${OC_AGENT_MEMORY:-4g} CHROME_MEM=${OC_CHROMIUM_MEMORY:-4g} DIND_MEM=${OC_DIND_MEMORY:-4g}
FWD_ENV=(ANTHROPIC_API_KEY OPENAI_API_KEY OPENROUTER_API_KEY GEMINI_API_KEY GOOGLE_API_KEY)
# Pod ports that must never be published: a mapped connection reaches the pod as 127.0.0.1, which
# Chromium DevTools (full browser control) and Postgres (trust auth, any role) accept without a password.
SENSITIVE_PORTS=(9222 5432)
RESERVED_NAMES=" agent chromium chrome postgres pg dind home "

usage() {
  cat <<EOF
Usage: ${0##*/} [-i NAME] [-r] [-n] [-p] [-D] [-K] [-P HOST:POD]... [-C DIR] [-W REPO[:BRANCH]]
       ${0##*/} [-i NAME] -x | -l | -k | [-i NAME] -d [-a] [-y] | -h

  (no flags)  Ensure everything exists (images, volumes, host bridge, pod, Chromium), then start
              OpenCode. Safe to run repeatedly; only missing/changed pieces are touched.
              If that instance's OpenCode is already running it only completes the setup (like -n).
  -i NAME     Work on instance NAME (default: the "default" instance). Every instance has its own
              pod, Chromium (and profile), Postgres data and docker-in-docker storage, so several can
              run the same app on the same ports at once. Names: a-z, 0-9, '-'.
  -C DIR      Working directory, relative to $SB (default: construct for the default
              instance, wt/NAME for others). Created if missing.
  -W REPO[:BRANCH]
              Make the working directory a git worktree of $SB/REPO on BRANCH (default: the
              instance name; created from REPO's HEAD if it does not exist). Runs inside a container.
  -P HOST:POD Publish pod port POD on the host as 127.0.0.1:HOST (repeatable, or comma-separated).
              Kept until changed; '-P none' removes all. Changing ports recreates the pod, which is
              refused while that instance's OpenCode runs. Ports ${SENSITIVE_PORTS[*]} are refused.
  -p          Also run Postgres in the pod (data volume per instance, survives restarts and -d;
              only -d -a deletes it). There are NO defaults: configure image/user/password/database
              first (~/.config/oc-sandbox/postgres.env, postgres.NAME.env, or OC_PG_*). See README.md.
  -D          Also run a docker-in-docker sidecar (rootless Podman) in the pod; the agent gets
              'docker' / 'docker compose' (DOCKER_HOST). Weaker isolation than the agent: see README.md.
  -n          Setup only: do not launch OpenCode.
  -r          Rebuild images from latest bases and recreate the pod.
  -x          Open a zsh shell inside that instance's running OpenCode container.
  -l          List instances.
  -k          List detected FIDO/U2F security keys (what would be passed to Chromium) and exit.
  -K          Do not pass any security key to Chromium on this run.
  -d          Delete: without -i, remove ALL instance pods and the host bridge; with -i, only that
              instance's pod. Keeps images, volumes and everything in $SB.
  -d -a       Also delete volumes (Chromium profile, Postgres data, docker storage; without -i also
              the OpenCode login, images, build files, SELinux module and $SB/.bridge).
  -y          Skip the confirmation prompt for -d -a.
  -h          This help.

Never touched: your files in $SB (including worktrees).
Inside OpenCode: 'code FILE' / 'bcompare A B' open copies on the host via a restricted bridge.
EOF
}
die() { echo "${0##*/}: $*" >&2; exit 2; }

# ---- option parsing ---------------------------------------------------------
DELETE=0 ALL=0 REBUILD=0 NOLAUNCH=0 YES=0 LISTKEYS=0 NOKEY=0 EXEC=0 PG=0 DIND=0 LIST=0
INST="" INST_SET=0 CWD_ARG="" WT_ARG="" PORT_ARGS=()
while getopts ":hdarnykKxplDi:P:C:W:" o; do
  case $o in
    h) usage; exit 0 ;;
    d) DELETE=1 ;; a) ALL=1 ;; r) REBUILD=1 ;; n) NOLAUNCH=1 ;; y) YES=1 ;;
    k) LISTKEYS=1 ;; K) NOKEY=1 ;; x) EXEC=1 ;; p) PG=1 ;; D) DIND=1 ;; l) LIST=1 ;;
    i) INST=$OPTARG INST_SET=1 ;; P) PORT_ARGS+=("$OPTARG") ;; C) CWD_ARG=$OPTARG ;; W) WT_ARG=$OPTARG ;;
    :) die "-$OPTARG needs a value" ;;
    *) usage >&2; exit 2 ;;
  esac
done
(( OPTIND > $# )) || die "unexpected argument: ${!OPTIND}"
if (( ALL && !DELETE )); then die "-a only makes sense with -d"; fi
if (( DELETE || EXEC || LIST || LISTKEYS )) && { (( PG || DIND || ${#PORT_ARGS[@]} )) || [[ -n $CWD_ARG$WT_ARG ]]; }; then
  die "-p, -D, -P, -C and -W only apply when setting up or starting an instance"
fi

# ---- names ----------------------------------------------------------------------------------------
valid_instance() {  # name -> 0/1
  [[ $1 =~ ^[a-z0-9]([a-z0-9-]{0,22}[a-z0-9])?$ ]] && [[ $RESERVED_NAMES != *" $1 "* ]]
}
# INST_SET records that -i was given at all: "-i default" selects the default instance only and must
# never fall through to the all-instances scope of a bare -d (or -d -a).
if (( INST_SET )) && [[ -z $INST ]]; then die "-i needs an instance name (use 'default' for the default instance)"; fi
[[ $INST == default ]] && INST=""
[[ -z $INST ]] || valid_instance "$INST" \
  || die "invalid instance name '$INST' (a-z, 0-9 and inner '-', at most 24 characters; not one of:$RESERVED_NAMES)"
set_names() {  # derive every per-instance resource name; the default instance keeps the original names
  local p
  if [[ -z $INST ]]; then p=oc ILABEL=default DEFAULT_CWD=construct POD=oc; else p=oc-$INST ILABEL=$INST DEFAULT_CWD=wt/$INST POD=$p; fi
  AGENT=$p-agent CHROME=$p-chromium PGC=$p-postgres DINDC=$p-dind
  CHROMEVOL=$p-chrome PGVOL=$p-pg PGSECRET=$p-pg-password DINDVOL=$p-dind DINDRUN=$p-dind-run
}
set_names

valid_relpath() {  # relative path below $SB without '.', '..' or empty components
  [[ $1 =~ ^[A-Za-z0-9._@+-]+(/[A-Za-z0-9._@+-]+)*$ ]] || return 1
  local IFS=/ c
  for c in $1; do [[ $c != . && $c != .. ]] || return 1; done
}
CWD=${CWD_ARG:-$DEFAULT_CWD}
valid_relpath "$CWD" || die "-C: '$CWD' must be a plain relative path inside $SB"
WT_REPO="" WT_BRANCH=""
if [[ -n $WT_ARG ]]; then
  WT_REPO=${WT_ARG%%:*}; WT_BRANCH=${WT_ARG#"$WT_REPO"}; WT_BRANCH=${WT_BRANCH#:}
  WT_BRANCH=${WT_BRANCH:-$ILABEL}
  valid_relpath "$WT_REPO" || die "-W: '$WT_REPO' must be a plain relative path inside $SB"
  [[ $WT_BRANCH =~ ^[A-Za-z0-9._/@+-]+$ ]] || die "-W: invalid branch name '$WT_BRANCH'"
fi

# ---- run podman/systemctl on the host even when invoked from a distrobox ----
if [[ -n ${CONTAINER_ID:-} ]] && command -v distrobox-host-exec >/dev/null 2>&1; then
  H=(distrobox-host-exec)
else
  H=()
fi
pm() { "${H[@]}" podman "$@"; }
sc() { "${H[@]}" systemctl --user "$@"; }
log() { printf '\033[1m==> %s\033[0m\n' "$*"; }
cstate() { pm container inspect --format '{{.State.Status}}' "$1" 2>/dev/null || echo none; }

# ---- ports ----------------------------------------------------------------------------------------
PORTS=() PORTS_SET=0
parse_ports() {  # PORT_ARGS -> PORTS ("HOST:POD"), refusing unsafe or impossible mappings
  local a it h c s seen=" " low items
  low=$("${H[@]}" cat /proc/sys/net/ipv4/ip_unprivileged_port_start 2>/dev/null || echo 1024)
  for a in "${PORT_ARGS[@]}"; do
    PORTS_SET=1
    if [[ $a == none ]]; then PORTS=(); continue; fi
    IFS=, read -ra items <<<"$a"
    for it in "${items[@]}"; do
      [[ $it =~ ^([0-9]{1,5}):([0-9]{1,5})$ ]] || die "-P: '$it' is not HOSTPORT:PODPORT"
      h=$((10#${BASH_REMATCH[1]})) c=$((10#${BASH_REMATCH[2]}))
      (( h >= 1 && h <= 65535 && c >= 1 && c <= 65535 )) || die "-P: '$it': ports are 1-65535"
      (( h >= low )) || die "-P: host port $h is below $low, which rootless Podman cannot bind; use e.g. $((h + 8000)):$c (the pod side may be any port)"
      for s in "${SENSITIVE_PORTS[@]}"; do
        (( c != s )) || die "-P: refusing to publish pod port $c: connections through a mapped port arrive as 127.0.0.1, which Chromium DevTools (9222) and Postgres (5432) trust without a password"
      done
      [[ $seen != *" $h "* ]] || die "-P: host port $h given twice"
      seen+="$h "; PORTS+=("$h:$c")
    done
  done
}
parse_ports
ports_label() { local IFS=,; printf '%s' "${PORTS[*]}"; }

# FIDO/U2F security keys: hidraw nodes whose HID usage page is 0xF1D0 (never keyboards/mice).
# Prints one line per key: /dev/hidrawN|Manufacturer Product|vid:pid
detect_keys() {
  "${H[@]}" sh -c 'for h in /sys/class/hidraw/hidraw*; do
    [ -r "$h/device/report_descriptor" ] || continue
    [ "$(head -c3 "$h/device/report_descriptor" | od -An -tx1 | tr -d " \n")" = 06d0f1 ] || continue
    u=$(readlink -f "$h/device")/../..
    printf "%s|%s %s|%s:%s\n" "/dev/${h##*/}" "$(cat "$u/manufacturer" 2>/dev/null)" \
      "$(cat "$u/product" 2>/dev/null)" "$(cat "$u/idVendor" 2>/dev/null)" "$(cat "$u/idProduct" 2>/dev/null)"
  done; true' 2>/dev/null || true
}

# Pods of all instances: labelled ones, plus the default pod made by versions before labels existed.
instance_pods() {
  { pm pod ls --filter label=oc.sandbox=1 --format '{{.Name}}' 2>/dev/null || true
    if pm pod exists oc 2>/dev/null; then echo oc; fi; } | sort -u
}

if (( LIST )); then
  printf '%-14s %-10s %-8s %-22s %-24s %s\n' INSTANCE POD AGENT PORTS "WORKING DIR" SIDECARS
  while read -r pod; do
    [[ -n $pod ]] || continue
    if [[ $pod == oc ]]; then inst=default INST=""; else inst=${pod#oc-} INST=${pod#oc-}; fi
    set_names
    ports=$(pm pod inspect "$pod" --format '{{index .Labels "oc.ports"}}' 2>/dev/null || true)
    wd=$(pm container inspect --format '{{.Config.WorkingDir}}' "$AGENT" 2>/dev/null || true)
    side=""
    for c in "$CHROME" "$PGC" "$DINDC"; do
      s=$(cstate "$c"); [[ $s == none ]] || side+="${c##*-}:$s "
    done
    printf '%-14s %-10s %-8s %-22s %-24s %s\n' "$inst" "$pod" "$(cstate "$AGENT")" \
      "$(sed 's/:/->/g' <<<"${ports:--}")" "${wd:--}" "${side:--}"
  done < <(instance_pods)
  exit 0
fi
if (( EXEC )); then
  [[ $(cstate "$AGENT") == running ]] \
    || { echo "OpenCode is not running in instance '$ILABEL'. Start it first (${0##*/}${INST:+ -i $INST}) in another terminal." >&2; exit 1; }
  wd=$(pm container inspect --format '{{.Config.WorkingDir}}' "$AGENT")
  exec "${H[@]}" podman exec -it -e SHELL=/bin/zsh -w "${wd:-/sandbox}" "$AGENT" zsh
fi
if (( LISTKEYS )); then
  keys=$(detect_keys)
  if [[ -z $keys ]]; then echo "No FIDO/U2F security keys detected."; exit 0; fi
  echo "Detected FIDO/U2F security keys (passed to Chromium unless -K):"
  while IFS='|' read -r node name id; do printf '  %-14s %s [%s]\n' "$node" "$name" "$id"; done <<<"$keys"
  exit 0
fi

# ---- Postgres settings: NO defaults; must be configured (see README.md) ---------------------------
# Read from OC_PG_* env vars or ~/.config/oc-sandbox/postgres.env (postgres.NAME.env for instance NAME
# if it exists; KEY=VALUE lines; env wins). These files live OUTSIDE the sandbox, so the agent cannot
# change which image/credentials get used.
#   OC_PG_IMAGE     image to run                       (required)
#   OC_PG_USER      superuser created on first start   (required)
#   OC_PG_PASSWORD  its password                       (required)
#   OC_PG_DB        initial database                   (required)
#   OC_PG_INIT_DIR  dir of *.sql/*.sh run once when the data volume is first created
#                   (optional; default ~/.config/oc-sandbox/postgres-init if it exists)
load_pg_config() {
  local k v line missing=() cdir=${XDG_CONFIG_HOME:-$HOME/.config}/oc-sandbox
  PG_CONF=$cdir/postgres.env
  [[ -n $INST && -f $cdir/postgres.$INST.env ]] && PG_CONF=$cdir/postgres.$INST.env
  PG_CONF=${OC_PG_CONF:-$PG_CONF}
  if [[ -f $PG_CONF ]]; then
    # KEY=VALUE lines (optional 'export ', spaces around '=' allowed). A quoted value is taken
    # literally; an unquoted one ends at whitespace followed by '#' (an inline comment).
    while IFS= read -r line || [[ -n $line ]]; do
      line=${line%$'\r'}
      [[ $line =~ ^[[:space:]]*(export[[:space:]]+)?(OC_PG_[A-Z_]+)[[:space:]]*=[[:space:]]*(.*)$ ]] || continue
      k=${BASH_REMATCH[2]} v=${BASH_REMATCH[3]}
      [[ -z ${!k:-} ]] || continue                     # environment wins over the file
      if [[ $v =~ ^\"([^\"]*)\"[[:space:]]*(#.*)?$ || $v =~ ^\'([^\']*)\'[[:space:]]*(#.*)?$ ]]; then
        v=${BASH_REMATCH[1]}
      else
        v=${v%%[[:space:]]#*}
        v=${v%"${v##*[![:space:]]}"}                   # trailing whitespace
      fi
      printf -v "$k" '%s' "$v"                         # a plain shell variable, NOT exported
    done < "$PG_CONF"
  fi
  # Values that came from the environment are un-exported too, so no child process (podman,
  # distrobox-host-exec, the agent) inherits the password. It reaches Postgres only as a secret.
  # shellcheck disable=SC2163  # un-exporting the variable NAMED by $k is the point
  for k in "${!OC_PG_@}"; do export -n "$k"; done
  for k in OC_PG_IMAGE OC_PG_USER OC_PG_PASSWORD OC_PG_DB; do
    [[ -n ${!k:-} ]] || missing+=("$k")
  done
  if (( ${#missing[@]} )); then
    echo "Postgres is not configured (missing: ${missing[*]})." >&2
    echo "There are deliberately no defaults. Create $PG_CONF" >&2
    echo "or set those variables; see \"Postgres configuration\" in $SCRIPT_DIR/README.md" >&2
    exit 1
  fi
  PG_IMAGE=$OC_PG_IMAGE PG_USER=$OC_PG_USER PG_PASSWORD=$OC_PG_PASSWORD PG_DB=$OC_PG_DB
  PG_INIT=${OC_PG_INIT_DIR:-$cdir/postgres-init}
}

# ---- teardown -----------------------------------------------------------------
confirm() { (( YES )) && return 0; read -r -p "$1 [y/N] " a; [[ $a == [yY]* ]]; }
if (( DELETE )); then
  if (( INST_SET )); then                                   # one instance only (also -i default)
    log "Removing instance '$ILABEL' (pod $POD)"
    pm pod rm -f "$POD" >/dev/null 2>&1 || true
    if (( ALL )); then
      if confirm "Also delete volumes $CHROMEVOL $PGVOL $DINDVOL $DINDRUN (Chromium profile, Postgres data, docker storage)?"; then
        for v in "$CHROMEVOL" "$PGVOL" "$DINDVOL" "$DINDRUN"; do pm volume rm -f "$v" >/dev/null 2>&1 || true; done
        pm secret rm "$PGSECRET" >/dev/null 2>&1 || true
      else echo "Skipped -a part."; fi
    fi
    log "Done. $SB/$DEFAULT_CWD (and any other files in $SB) left untouched."
    exit 0
  fi
  for pod in $(instance_pods); do log "Removing pod '$pod'"; pm pod rm -f "$pod" >/dev/null 2>&1 || true; done
  log "Removing host bridge"
  sc disable --now oc-bridge.path >/dev/null 2>&1 || true
  rm -f "$UNITS/oc-bridge.path" "$UNITS/oc-bridge.service" "$BIN/oc-bridge"
  sc daemon-reload >/dev/null 2>&1 || true
  if (( ALL )); then
    if ! confirm "Also delete ALL oc-sandbox volumes (OpenCode login, Chromium profiles, Postgres data, docker storage), images and build files?"; then
      echo "Skipped -a part."; exit 0
    fi
    log "Removing images, volumes, secrets, build files"
    pm rmi -f "$AGENT_IMG" "$CHROME_IMG" >/dev/null 2>&1 || true
    mapfile -t vols < <({ pm volume ls -q --filter label=oc.sandbox=1; printf '%s\n' "$HOMEVOL" oc-chrome oc-pg; } | sort -u)
    for v in "${vols[@]}"; do pm volume rm -f "$v" >/dev/null 2>&1 || true; done
    # No matching secret (never used -p) is normal; failing to list them only warns, so the rest of
    # the cleanup (SELinux module, state, .bridge) still runs.
    if secrets=$(pm secret ls --format '{{.Name}}' 2>/dev/null); then
      while read -r s; do
        if [[ $s =~ ^oc(-[a-z0-9-]+)?-pg-password$ ]]; then pm secret rm "$s" >/dev/null 2>&1 || true; fi
      done <<<"$secrets"
    else echo "warning: could not list Podman secrets; remove any oc-*-pg-password secrets by hand" >&2; fi
    log "Removing SELinux module oc_chromium (asks for your admin password)"
    "${H[@]}" pkexec semodule -r oc_chromium >/dev/null 2>&1 || "${H[@]}" sudo semodule -r oc_chromium || true
    # Safe on the host: every pod (and with it every agent) is gone, so nothing can change $SB/.bridge
    # concurrently, and GNU rm -r never follows symlinks (it unlinks them).
    rm -rf "$STATE" "$SB/.bridge"
  fi
  log "Done. Your files in $SB left untouched."
  exit 0
fi

if (( PG )); then load_pg_config; fi   # fail early, before building or starting anything

# ---- preflight ----------------------------------------------------------------
pm --version >/dev/null 2>&1 || { echo "podman not found" >&2; exit 1; }
WL="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/${WAYLAND_DISPLAY:-wayland-0}"
[[ -S $WL ]] || { echo "No Wayland socket at $WL (run from a KDE Wayland session)" >&2; exit 1; }
"${H[@]}" test -x "$BC_BIN"   || echo "warning: $BC_BIN not found; 'bcompare' bridge will do nothing" >&2
"${H[@]}" test -x "$CODE_BIN" || echo "warning: $CODE_BIN not found; 'code' bridge will do nothing" >&2

# ---- directories / config -----------------------------------------------------
# Host-owned directories only. Nothing inside $SB is created from the host: see init_sandbox_tree.
mkdir -p "$SB" "$BUILD" "$BIN" "$UNITS"

# One SELinux level (MCS categories) shared by all agents, so several can use $SB at once; generated
# once per installation. Podman's ':Z' would give every agent a new level (cutting the others off)
# and would walk the agent-writable tree on the host; relabel_shared does it inside a container instead.
if [[ ! -s $STATE/sb-level ]]; then
  a=$((RANDOM % 1024)); b=$(( (a + 1 + RANDOM % 1023) % 1024 )); (( a < b )) || { t=$a; a=$b; b=$t; }
  printf 's0:c%d,c%d\n' "$a" "$b" > "$STATE/sb-level"
fi
LEVEL=$(< "$STATE/sb-level")
[[ $LEVEL =~ ^s0:c[0-9]+,c[0-9]+$ ]] || { echo "corrupt $STATE/sb-level (delete it and rerun)" >&2; exit 1; }

# The agent can replace anything inside $SB (e.g. construct/ or .bridge/ with a symlink to a host
# directory) at any moment, so the host never creates, writes, relabels or runs git on paths in it.
# Throwaway containers that see ONLY $SB (at /sandbox) do it instead: a symlink there resolves inside
# that container's own filesystem, so whatever it points to, nothing outside $SB can be reached, and
# no check-then-use race exists to win. label=disable avoids relabelling $SB while agents run; these
# containers have no network, no capabilities (FOWNER for relabelling only) and run fixed commands.
safe_run() { pm run --rm -i --network=none --cap-drop=ALL --security-opt=no-new-privileges \
  --security-opt=label=disable -v "$SB":/sandbox "$@"; }

init_sandbox_tree() {  # dest [repo branch]: spool dirs, working directory, optional git worktree
  safe_run --entrypoint sh "$AGENT_IMG" -c '
    set -e; cd /sandbox; dest=$1 repo=$2 branch=$3
    mkdir -p .bridge/requests .bridge/tmp .bridge/files
    if [ -n "$repo" ] && [ ! -e "$dest/.git" ]; then
      git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || { echo "-W: $repo is not a git repository" >&2; exit 3; }
      git check-ref-format --branch "$branch" >/dev/null 2>&1 || { echo "-W: invalid branch name $branch" >&2; exit 3; }
      mkdir -p "$(dirname "$dest")"
      # hooks off: the repository is agent-controlled (and this container must stay a fixed command)
      g="git -C $repo -c core.hooksPath=/dev/null worktree add --relative-paths"
      if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then $g "/sandbox/$dest" "$branch"
      else $g -b "$branch" "/sandbox/$dest"; fi
    fi
    mkdir -p "$dest"' sh "$1" "${2:-}" "${3:-}"
}

RELABEL_PY='import os, sys
ctx = sys.argv[1].encode(); bad = 0
def lab(p):
    global bad
    try:
        if os.getxattr(p, "security.selinux", follow_symlinks=False).rstrip(b"\0") != ctx:
            os.setxattr(p, "security.selinux", ctx, follow_symlinks=False)
    except OSError:
        bad += 1
for top in sys.argv[2:]:
    lab(top)
    for root, dirs, files in os.walk(top):          # never follows symlinks; labels the links themselves
        for x in dirs + files:
            lab(os.path.join(root, x))
if bad:
    print(f"relabel: {bad} entries could not be relabelled (agents may not be able to use them)", file=sys.stderr)'
relabel_shared() {  # give $SB and the shared home volume the agents' level (inside a container)
  safe_run --cap-add=FOWNER -v "$HOMEVOL":/home-vol --entrypoint python3 "$AGENT_IMG" \
    -I -c "$RELABEL_PY" "system_u:object_r:container_file_t:$LEVEL" /sandbox /home-vol
}

# ---- build context ------------------------------------------------------------
cat > "$BUILD/Containerfile.agent" <<'EOF'
FROM ghcr.io/anomalyco/opencode:latest
RUN apk add --no-cache nodejs npm git zsh vim tmux jq curl less ripgrep fd ncurses \
      build-base make perl xz python3 py3-pip postgresql17-client \
      bash tar unzip docker-cli docker-cli-compose
COPY oh-my-zsh /opt/oh-my-zsh
COPY zshrc /opt/zsh/.zshrc
COPY gitconfig /etc/gitconfig
COPY gitignore_global /etc/gitignore_global
COPY bridge-open /usr/local/bin/bridge-open
COPY opencode-sandbox.json /etc/opencode/oc-sandbox.json
RUN chmod +x /usr/local/bin/bridge-open \
 && ln -s bridge-open /usr/local/bin/code \
 && ln -s bridge-open /usr/local/bin/bcompare
# PATH: self-updating OpenCode lives in the oc-home volume (/root/.opencode) and wins over the baked copy.
# TAR_OPTIONS: the updater untars as root without CHOWN (we drop all caps), so skip ownership restore.
# OPENCODE_CONFIG: extra config (Chromium DevTools MCP) merged with your global and project configs.
ENV OC_SANDBOX=1 ZDOTDIR=/opt/zsh LANG=en_US.UTF-8 TAR_OPTIONS=--no-same-owner \
    OPENCODE_CONFIG=/etc/opencode/oc-sandbox.json \
