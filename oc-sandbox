(( record_rc == 0 || record_rc == 3 )) || die "unsafe worktree record for $ILABEL"
if [[ -z $CWD_ARG ]] && (( record_rc == 0 )); then
  { IFS= read -r saved_cwd; IFS= read -r saved_repo; IFS= read -r saved_branch; } <<<"$record" \
    || die "invalid worktree record for $ILABEL"
  valid_relpath "$saved_cwd" && valid_relpath "$saved_repo" && [[ $saved_branch =~ ^[A-Za-z0-9._/@+-]+$ ]] \
    || die "invalid worktree record for $ILABEL"
  CWD=$saved_cwd
  if [[ -z $WT_ARG ]]; then WT_REPO=$saved_repo WT_BRANCH=$saved_branch; fi
fi
if [[ -z $CWD_ARG && -z $WT_ARG && -z $WT_REPO && -n $INST ]]; then
  here=${CALLER_PWD%/}; relative=""
  case "$here/" in
    "$SB/"*) relative=${here#"$SB"/} ;;
    "$sb_real/"*) relative=${here#"$sb_real"/} ;;
  esac
  if [[ -z $relative || $relative == "$here" ]]; then
    physical=$CALLER_PHYSICAL
    if [[ $physical/ == "$sb_real/"* && $physical != "$sb_real" ]]; then
      die "refusing a current directory reached through a sandbox path alias"
    fi
  fi
  if [[ -n $relative && $relative != "$here" ]]; then
    valid_relpath "$relative" || die "current directory is not a plain sandbox path"
    WT_REPO=$(tree_run detect "$relative") \
      || die "could not safely inspect the current repository"
    if [[ -n $WT_REPO ]]; then
      valid_relpath "$WT_REPO" || die "invalid detected repository path"
      WT_BRANCH=$ILABEL; CWD="wt/$WT_REPO/$ILABEL"
      echo "worktree of $WT_REPO on branch $WT_BRANCH at $SB/$CWD (override with -W or -C)"
    fi
  fi
fi
init_sandbox_tree "$CWD" "$WT_REPO" "$WT_BRANCH" \
  || { echo "could not prepare $SB/$CWD and $SB/.bridge (see above)" >&2; exit 1; }
if [[ -n $WT_REPO ]]; then
  worktree_state write "$ILABEL" "$CWD" "$WT_REPO" "$WT_BRANCH" || die "could not safely record worktree for $ILABEL"
fi
release_worktree_lock
# New worktree/directory entries need the same label; this container can see only $SB.
safe_run --cap-add=FOWNER --entrypoint python3 "$AGENT_IMG" \
  -I -c "$RELABEL_CWD_PY" "system_u:object_r:container_file_t:$LEVEL" "$CWD" \
  || { echo "could not relabel $SB/$CWD (see above)" >&2; exit 1; }
# A worktree also writes metadata in its source repository after the shared relabel.
if [[ -n $WT_REPO && $WT_REPO != "$CWD" ]]; then
  safe_run --cap-add=FOWNER --entrypoint python3 "$AGENT_IMG" \
    -I -c "$RELABEL_CWD_PY" "system_u:object_r:container_file_t:$LEVEL" "$WT_REPO" \
    || { echo "could not relabel $SB/$WT_REPO (see above)" >&2; exit 1; }
fi

# Keyed hash of the settings Postgres only reads when its volume is created. The key (random, mode
# 0600, outside the sandbox) keeps the volume label from being an offline guessable hash of the password.
pg_sig() {
  local key=$STATE/pg-sig.key fd old_umask tmp
  (umask 077; mkdir -p "$STATE")
  /usr/bin/python3 -I -c 'import os, sys
fd = os.open(sys.argv[1], os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
s = os.fstat(fd)
if s.st_uid != os.geteuid() or s.st_mode & 0o022: sys.exit("unsafe Postgres state directory")' "$STATE" || return 1
  # The persistent per-key lock serializes first creation. Rename makes a fully
  # written 0600 key visible at once without transient hard links.
  old_umask=$(umask); umask 077
  exec {fd}>>"$STATE/pg-sig.lock"
  umask "$old_umask"
  flock "$fd" || { exec {fd}>&-; return 1; }
  if [[ ! -s $key ]]; then
    tmp=$(mktemp "$STATE/.pg-sig.XXXXXXXX") || { exec {fd}>&-; return 1; }
    if ! /usr/bin/python3 -I -c 'import secrets; print(secrets.token_hex(32), end="")' > "$tmp" \
      || ! mv -f -- "$tmp" "$key"; then
      rm -f -- "$tmp"; exec {fd}>&-; return 1
    fi
  fi
  { cat "$key"; printf '|%s|%s|%s|%s' "$PG_USER" "$PG_PASSWORD" "$PG_DB" "$1"; } | sha256sum | cut -c1-16 \
    || { exec {fd}>&-; return 1; }
  exec {fd}>&-
}

# libpq password-file fields escape backslashes and colons; keep secrets in shell
# memory and stream them to Podman, never in arguments or environment variables.
pgpass_field() {
  local field=$1
  field=${field//\\/\\\\}; field=${field//:/\\:}
  printf '%s' "$field"
}
create_pg_auth_secrets() {
  printf '%s\n' 'local all all trust' 'host all all 0.0.0.0/0 scram-sha-256' 'host all all ::/0 scram-sha-256' |
    pm secret create --replace "$PGHBASECRET" - >/dev/null || return 1
  { printf '127.0.0.1:5432:'; pgpass_field "$PG_DB"; printf ':'; pgpass_field "$PG_USER"; printf ':'; pgpass_field "$PG_PASSWORD"; printf '\n'; } |
    pm secret create --replace "$PGPASSSECRET" - >/dev/null || return 1
}
ensure_postgres() {
  local pg_state pg_cfg want_cfg sig legacy vsig init_hash ok=0 p init
  local pgargs=() init_fields=()
  init=$(host_input postgres-init "$PG_INIT") || die "could not inspect the host Postgres init directory"
  mapfile -t init_fields <<<"$init"
  init_hash=${init_fields[1]:-}
  [[ ${init_fields[0]:-} == /* && ${#init_fields[@]} -le 2 && $init_hash =~ ^([0-9a-f]{16})?$ ]] \
    || die "invalid host Postgres init metadata"
  if [[ -n $init_hash ]]; then
    pgargs+=(-v "${init_fields[0]}:/docker-entrypoint-initdb.d:ro,Z")
  fi
  # Postgres only reads user/password/db/init scripts when the data volume is first created, so the
  # volume remembers the settings it was created with; a mismatch is refused instead of silently ignored.
  sig=k1:$(pg_sig "$init_hash")
  if pm volume exists "$PGVOL" 2>/dev/null; then
    vsig=$(pm volume inspect "$PGVOL" --format '{{index .Labels "oc.pgcfg"}}' 2>/dev/null || true)
    # volumes made by earlier versions carry an unkeyed hash: still accepted, with a notice
    legacy=$(printf '%s|%s|%s|%s' "$PG_USER" "$PG_PASSWORD" "$PG_DB" "$init_hash" | sha256sum | cut -c1-16)
    if [[ $vsig == "$legacy" ]]; then
      echo "note: volume '$PGVOL' (made by an older oc-sandbox) is labelled with an unkeyed hash of the" >&2
      echo "      Postgres settings; recreate it when convenient: ${0##*/} -i $ILABEL -d && podman volume rm $PGVOL" >&2
    elif [[ $vsig != "$sig" ]]; then
      if [[ -z $vsig ]]; then
        echo "Volume '$PGVOL' has no recorded Postgres settings (created by an older version)." >&2
      else
        echo "Postgres settings changed since volume '$PGVOL' was created (user/password/database/init scripts)," >&2
        echo "or $STATE/pg-sig.key was deleted." >&2
      fi
      echo "Postgres ignores those settings on an existing volume. To apply them, discard the data first:" >&2
      # always '-i NAME' (also '-i default'): a bare -d would remove every instance and the bridge
      echo "    ${0##*/} -i $ILABEL -d && podman volume rm $PGVOL     # then rerun with -p" >&2
      exit 1
    fi
  else
    pm volume create --label oc.sandbox=1 --label "oc.instance=$ILABEL" --label "oc.pgcfg=$sig" "$PGVOL" >/dev/null
  fi

  want_cfg="v3:scram:$sig:$PG_IMAGE"
  pg_state=$(cstate "$PGC")
  pg_cfg=$(pm container inspect --format '{{index .Config.Labels "oc.pg"}}' "$PGC" 2>/dev/null || true)
  if [[ $pg_state != none && $pg_cfg != "$want_cfg" ]]; then
    log "Postgres container settings changed; recreating it (data volume $PGVOL is kept)"
    pm rm -f "$PGC" >/dev/null; pg_state=none
  fi
  # A stopped container is recreated so every start receives fresh, script-owned
  # secrets. PostgreSQL reads hba_file at process start, before any TCP listener.
  if [[ $pg_state != none && $pg_state != running ]]; then
    pm rm -f "$PGC" >/dev/null || return 1; pg_state=none
  fi
  create_pg_auth_secrets || { echo "Could not create Postgres authentication secrets." >&2; return 1; }
  case $pg_state in
    running) echo "Postgres already running." ;;
    none)
      log "Creating Postgres in pod '$POD' (image $PG_IMAGE, volume $PGVOL)"
      # The password goes over stdin into a Podman secret and is mounted as a file: it never appears
      # in any argv, in the container's environment, or in 'podman inspect'.
      printf '%s' "$PG_PASSWORD" | pm secret create --replace "$PGSECRET" - >/dev/null
      pm run -d --name "$PGC" --pod "$POD" --label "oc.pg=$want_cfg" --security-opt=no-new-privileges \
        --cap-drop=ALL --cap-add=CHOWN --cap-add=SETUID --cap-add=SETGID \
        --cap-add=FOWNER --cap-add=DAC_OVERRIDE \
        --pids-limit=256 --memory=2g \
        -v "$PGVOL":/var/lib/postgresql/data:Z "${pgargs[@]}" \
        --secret "$PGSECRET",type=mount,target=/run/secrets/postgres-password \
        --secret "$PGHBASECRET",type=mount,target=/run/secrets/oc-pg-hba,mode=0444 \
        --secret "$PGPASSSECRET",type=mount,target=/run/secrets/oc-pgpass,mode=0600 \
        -e POSTGRES_PASSWORD_FILE=/run/secrets/postgres-password \
        -e POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256 \
        -e POSTGRES_USER="$PG_USER" -e POSTGRES_DB="$PG_DB" \
        --entrypoint docker-entrypoint.sh "$PG_IMAGE" postgres \
        -c listen_addresses=127.0.0.1 -c hba_file=/run/secrets/oc-pg-hba \
        -c password_encryption=scram-sha-256 >/dev/null ;;
  esac
  for _ in $(seq 1 60); do
    pm exec "$PGC" pg_isready -h 127.0.0.1 -U "$PG_USER" -d "$PG_DB" -q 2>/dev/null && { ok=1; break; }
    sleep 1
  done
  (( ok )) || { echo "Postgres did not become ready:" >&2; pm logs --tail 15 "$PGC" >&2; exit 1; }
  # The read-only, script-owned hba_file is passed on the postgres command line,
  # so volume-local pg_hba.conf is never authoritative, including during initdb.
  # pg_isready does not authenticate. This TCP login proves that the configured
  # password and the existing volume's verifier work with SCRAM before reporting ready.
  if ! pm exec "$PGC" env PGPASSFILE=/run/secrets/oc-pgpass psql -w -X -h 127.0.0.1 -U "$PG_USER" -d "$PG_DB" -Atqc 'SELECT 1' >/dev/null 2>&1; then
    echo "Postgres SCRAM login failed; existing password verifier may need migration. Stopping Postgres." >&2
    pm stop -t 5 "$PGC" >/dev/null || true; return 1
  fi
  echo "Postgres ready (TCP requires SCRAM authentication)."
  echo "  psql -h 127.0.0.1 -U $PG_USER -d $PG_DB"
  echo "  DATABASE_URL=postgres://$(urlenc "$PG_USER")@127.0.0.1:5432/$(urlenc "$PG_DB")"
  for p in "${PORTS[@]}"; do
    [[ ${p#*:} == 5432 ]] && echo "  Host: postgresql://$(urlenc "$PG_USER")@127.0.0.1:${p%%:*}/$(urlenc "$PG_DB")"
  done
  return 0
}

urlenc() {  # percent-encode for a URL component (byte-wise, so UTF-8 comes out right)
  local LC_ALL=C s=$1 out='' c i
  for (( i = 0; i < ${#s}; i++ )); do
    c=${s:i:1}
    case $c in [A-Za-z0-9._~-]) out+=$c ;; *) printf -v c '%%%02X' "'$c"; out+=$c ;; esac
  done
  printf '%s' "$out"
}

# Docker-in-docker: rootless Podman in a sidecar, reachable by the agent only through a socket in a
# small per-instance volume. It needs what nested rootless containers need (default capabilities,
# setuid newuidmap, /dev/fuse, /dev/net/tun) and runs SELinux-unconfined (label=disable): weaker than
# the agent, hence opt-in. Nested containers share the pod's network with --network host.
# Reuse a running managed server on a plain relaunch without loading PG config or
# changing the server. Compare the mounted bytes to the current named secret:
# --replace can legitimately give identical secrets different Podman IDs.
agent_pg_passfile() {
  local state cfg mounted current
  (( PG )) && return 0
  state=$(cstate "$PGC")
  [[ $state != none ]] || return 1
  if [[ $state != running ]]; then
    die "Postgres for '$ILABEL' is not running; rerun with -p to start it"
  fi
  cfg=$(pm container inspect --format '{{index .Config.Labels "oc.pg"}}' "$PGC" 2>/dev/null) \
    || die "could not inspect Postgres for '$ILABEL'; rerun with -p"
  [[ $cfg == v3:scram:* ]] || die "Postgres for '$ILABEL' is not a managed SCRAM server; rerun with -p to upgrade it"
  mounted=$(pm exec "$PGC" sha256sum /run/secrets/oc-pgpass 2>/dev/null) \
    || die "Postgres passfile is missing; rerun with -p"
  current=$(pm run --rm --network=none --cap-drop=ALL --security-opt=no-new-privileges \
    --security-opt=label=disable --user 0 \
    --secret "$PGPASSSECRET",type=mount,target=/run/secrets/oc-pgpass,mode=0600 \
    --entrypoint sha256sum "$AGENT_IMG" /run/secrets/oc-pgpass 2>/dev/null) \
    || die "Postgres passfile secret is missing; rerun with -p"
  mounted=${mounted%% *}; current=${current%% *}
  [[ $mounted =~ ^[0-9a-f]{64}$ && $current == "$mounted" ]] \
    || die "Postgres passfile secret is stale; rerun with -p to refresh it"
}

ensure_dind() {
  local want="v1:$DIND_IMG" have state ok=0 pull=()
  (( REBUILD )) && pull=(--pull=newer)
  state=$(cstate "$DINDC")
  have=$(pm container inspect --format '{{index .Config.Labels "oc.dind"}}' "$DINDC" 2>/dev/null || true)
  if [[ $state != none && $have != "$want" ]]; then
    log "docker-in-docker settings changed; recreating it (storage volume $DINDVOL is kept)"
    pm rm -f "$DINDC" >/dev/null; state=none
  fi
  ensure_volume "$DINDVOL" "$ILABEL"; ensure_volume "$DINDRUN" "$ILABEL"
  case $state in
    running) echo "docker-in-docker already running." ;;
    none)
      log "Starting docker-in-docker sidecar in pod '$POD' (image $DIND_IMG, storage $DINDVOL)"
      pm run -d "${pull[@]}" --name "$DINDC" --pod "$POD" --label "oc.dind=$want" \
        --user podman --device /dev/fuse --device /dev/net/tun --security-opt label=disable \
        --pids-limit=4096 --memory="$DIND_MEM" \
        -v "$DINDVOL":/home/podman/.local/share/containers -v "$DINDRUN":/run/dind:U -v "$SB":/sandbox:ro \
        "$DIND_IMG" sh -c 's=/run/dind/podman.sock; rm -f $s
          podman system service --time=0 unix://$s & i=0
          while [ ! -S $s ] && [ $i -lt 300 ]; do sleep 0.1; i=$((i + 1)); done
          chmod 0666 $s; wait' >/dev/null ;;
    *) log "Starting existing docker-in-docker sidecar"; pm start "$DINDC" >/dev/null ;;
  esac
  for _ in $(seq 1 60); do
    pm exec "$DINDC" curl -sf --unix-socket /run/dind/podman.sock http://d/_ping >/dev/null 2>&1 && { ok=1; break; }
    sleep 1
  done
  (( ok )) || { echo "docker-in-docker did not become ready:" >&2; pm logs --tail 15 "$DINDC" >&2; exit 1; }
  echo "docker-in-docker ready: 'docker run --network host ...' shares this pod's network (127.0.0.1)."
}

# Stop a legacy Postgres before any pod publishing/recreation can expose it. The
# versioned label is set only on containers created with the enforced SCRAM HBA.
if (( PG )) && [[ $(cstate "$PGC") == running ]]; then
  pg_old_cfg=$(pm container inspect --format '{{index .Config.Labels "oc.pg"}}' "$PGC" 2>/dev/null || true)
  if [[ $pg_old_cfg != v3:scram:* ]]; then
    log "Stopping legacy Postgres before enabling authenticated host access"
    pm stop -t 5 "$PGC" >/dev/null || die "could not stop legacy Postgres; refusing to publish ports"
  fi
fi

# ---- pod ------------------------------------------------------------------------------------------
# Every pod gets pasta's --host-lo-to-ns-lo (published ports reach apps bound to 127.0.0.1 in the pod)
# and an unprivileged-port sysctl scoped to the pod's network namespace (apps may bind ports < 1024
# without NET_BIND_SERVICE). Ports are fixed at pod creation; the label records them.
pod_exists() {
  local rc=0
  pm pod exists "$POD" >/dev/null 2>&1 || rc=$?
  (( rc == 0 )) && return 0
  (( rc == 1 )) && return 1
  die "could not determine whether pod '$POD' exists"
}
# The stored label is not proof of actual bindings. Refuse malformed, hidden,
# non-loopback or mismatched mappings before reusing or recreating an existing pod.
# The caller's directory can be inside the sandbox, so run isolated: without -I, Python
# would import json and re from that directory before the standard library. PATH is the
# caller's too, so name the system interpreter by absolute path.
validate_existing_ports() {
  /usr/bin/python3 -I -c '
import json, re, sys
try:
    bindings = json.loads(sys.argv[1]); label = sys.argv[2]; pg = sys.argv[3] == "1"
    if bindings is None: bindings = {}
    if not isinstance(bindings, dict): raise ValueError("invalid bindings")
    actual = []
    for key, values in bindings.items():
        m = re.fullmatch(r"([0-9]+)/tcp", key)
        if not m or not isinstance(values, list): raise ValueError("unsupported binding")
        target = int(m.group(1))
        if not 1 <= target <= 65535: raise ValueError("invalid pod port")
        if target == 9222 or 8401 <= target <= 8416: raise ValueError("sensitive pod port is published")
        if target == 5432 and not pg: raise ValueError("Postgres port requires -p")
        for value in values:
            if not isinstance(value, dict) or value.get("HostIp") != "127.0.0.1": raise ValueError("non-loopback binding")
            hp = value.get("HostPort", "")
            if not isinstance(hp, str) or not hp.isdecimal() or not 1 <= int(hp) <= 65535: raise ValueError("invalid host port")
            actual.append(f"{int(hp)}:{target}")
    expected = label.split(",") if label else []
    if any(not re.fullmatch(r"[0-9]+:[0-9]+", p) for p in expected): raise ValueError("malformed port label")
    if sorted(actual) != sorted(expected): raise ValueError("actual bindings do not match port label")
except (ValueError, TypeError, json.JSONDecodeError) as e:
    print(f"unsafe existing pod ports: {e}", file=sys.stderr); sys.exit(1)
' "$1" "$2" "$3"
}
INHERITED_PG_VERIFIED=0
if pod_exists; then
  have_ports=$(pm pod inspect "$POD" --format '{{index .Labels "oc.ports"}}') || die "could not read existing pod port label"
  have_bindings=$(pm pod inspect "$POD" --format '{{json .InfraConfig.PortBindings}}') || die "could not inspect existing pod bindings"
  if ! validate_existing_ports "$have_bindings" "$have_ports" "$PG" 2>/dev/null; then
    if (( !PG && !PORTS_SET )) && agent_pg_passfile \
      && validate_existing_ports "$have_bindings" "$have_ports" 1; then
      INHERITED_PG_VERIFIED=1
    else
      die "refusing to use pod '$POD'; remove or recreate it after inspecting its ports"
    fi
  fi
fi
if pod_exists && (( !PORTS_SET )); then
  if [[ -n $have_ports ]]; then
    # A verified existing SCRAM server may retain its recorded binding. Explicit
    # new -P 5432 mappings still require the user to supply -p during parsing.
    PORT_ARGS=("$have_ports"); PORTS=()
    if (( INHERITED_PG_VERIFIED )); then PG=1; parse_ports; PG=0; else parse_ports; fi
    PORTS_SET=0
  fi
fi
want_podcfg="v1|$(ports_label)"
recreate=""
if pod_exists; then
  have_podcfg=$(pm pod inspect "$POD" --format '{{index .Labels "oc.podcfg"}}' 2>/dev/null || true)
  if (( REBUILD )); then recreate="rebuild (-r)"
  elif (( PORTS_SET )) && [[ $have_podcfg != "$want_podcfg" ]]; then recreate="port mapping changed"
  fi
fi
if [[ -n $recreate ]]; then
  if [[ $(cstate "$AGENT") == running ]]; then
    echo "Cannot recreate pod '$POD' ($recreate): OpenCode is running in instance '$ILABEL'." >&2
    echo "Exit it first, then rerun this command." >&2
    exit 1
  fi
  if any_relay_running "$POD"; then
    echo "Cannot recreate pod '$POD' ($recreate): Provider relay is running in instance '$ILABEL'." >&2
    echo "Exit it first, then rerun this command." >&2
    exit 1
  fi
  # keep the sidecars this instance had (their data lives in volumes)
  if [[ $(cstate "$PGC") != none ]] && (( !PG )); then PG=1; load_pg_config; fi
  [[ $(cstate "$DINDC") != none ]] && DIND=1
  log "Recreating pod '$POD' ($recreate)"
  pm pod rm -f "$POD" >/dev/null
fi
if ! pod_exists; then
  log "Creating pod '$POD'${PORTS[*]:+ (ports: $(ports_label))}"
  podargs=()
  for p in "${PORTS[@]}"; do podargs+=(-p "127.0.0.1:$p"); done
  pm pod create --name "$POD" --label oc.sandbox=1 --label "oc.instance=$ILABEL" \
    --label "oc.podcfg=$want_podcfg" --label "oc.ports=$(ports_label)" \
    --network pasta:--host-lo-to-ns-lo --sysctl net.ipv4.ip_unprivileged_port_start=0 \
    "${podargs[@]}" >/dev/null
fi

# ---- Chromium ---------------------------------------------------------------------------------------
want_id=$(pm image inspect --format '{{.Id}}' "$CHROME_IMG")
have_id=$(pm container inspect --format '{{.Image}}' "$CHROME" 2>/dev/null || true)
have_cfg=$(pm container inspect --format '{{index .Config.Labels "oc.cfg"}}' "$CHROME" 2>/dev/null || true)
# Security keys: pass only FIDO hidraw nodes to desktop Chromium when enabled.
display_args=()
browser_mode=(--headless)
starturl=()
keys=""
if [[ $CHROMIUM_MODE == wayland ]]; then
  display_args=(-v "$WL":/run/xdg/wayland-1 -e XDG_RUNTIME_DIR=/run/xdg -e WAYLAND_DISPLAY=wayland-1)
  browser_mode=(--ozone-platform=wayland)
  # Use the instance name as the desktop window's initial title.
  [[ -z $INST ]] || starturl=("data:text/html,%3Ctitle%3Eoc%20$INST%3C/title%3E%3Ch1%3Eoc-sandbox%20instance%20$INST%3C/h1%3E")
  if (( NOKEY )); then
    echo "Security keys: disabled (-K)"
  else
    keys=$(detect_keys)
    [[ -n $keys ]] || echo "Security key: none detected (plug one in and rerun to use it)"
  fi
fi
fido_nodes=$(fido_device_nodes <<<"$keys")
devargs=()
while IFS= read -r n; do [[ -z $n ]] || devargs+=(--device "$n"); done <<<"$fido_nodes"
(( ${#devargs[@]} )) && devargs+=(-v /run/udev:/run/udev:ro)   # Chromium enumerates HID via udev
while IFS='|' read -r node name id; do
  [[ -n $node ]] && echo "Security key: $name [$id] -> $node"
done <<<"$keys"
# recreate the container only if its run command, policy, or security-key set changed
cfg=$( { sed -n '/^# >>>chromium-run/,/^# <<<chromium-run/p' "$SCRIPT_REAL"; printf '%s\n' "$CHROMIUM_MODE" "$fido_nodes"; cat "$POLDIR/oc_chromium.cil"; } | sha256sum | cut -c1-16)
if [[ -n $have_id && ( $have_id != "$want_id" || $have_cfg != "$cfg" ) ]]; then
  log "Chromium image/config changed; recreating container"
  pm rm -f "$CHROME" >/dev/null
  have_id=
fi
if [[ -z $have_id ]]; then
  # A crash/reboot leaves SingletonLock naming the old pod's hostname; Chromium then refuses the profile.
  # No Chromium container for this instance exists at this point, so clearing the locks is safe.
  pm run --rm --entrypoint sh --cap-drop=ALL --cap-add=DAC_OVERRIDE -v "$CHROMEVOL":/profile:Z "$CHROME_IMG" \
     -c 'rm -f /profile/SingletonLock /profile/SingletonCookie /profile/SingletonSocket' >/dev/null 2>&1 || true
  log "Starting Chromium"
  # DAC_OVERRIDE: Chromium's crashpad handler aborts without it under --cap-drop=ALL.
  # label type oc_chromium.process: custom SELinux type (see policy dir) that may use the Wayland socket.
# >>>chromium-run
  pm run -d --name "$CHROME" --pod "$POD" --label "oc.cfg=$cfg" \
    --cap-drop=ALL --cap-add=DAC_OVERRIDE --security-opt=no-new-privileges \
    --security-opt label=type:oc_chromium.process \
    --pids-limit=1024 --memory="$CHROME_MEM" --shm-size=1g \
    -v "$CHROMEVOL":/profile:Z \
    "${devargs[@]}" "${display_args[@]}" \
    "$CHROME_IMG" \
    chromium-browser "${browser_mode[@]}" --no-sandbox --disable-gpu \
      --no-first-run --no-default-browser-check --class="oc-$ILABEL" \
      --user-data-dir=/profile --remote-debugging-port=9222 "${starturl[@]}" >/dev/null
# <<<chromium-run
elif [[ $(cstate "$CHROME") != running ]]; then
  log "Starting existing Chromium container"
  pm start "$CHROME" >/dev/null
fi

log "Waiting for Chromium DevTools (127.0.0.1:9222 inside pod '$POD')"
ok=0
for _ in $(seq 1 30); do
  if pm exec "$CHROME" curl -sf http://127.0.0.1:9222/json/version >/dev/null 2>&1; then ok=1; break; fi
  sleep 1
done
if (( !ok )); then
  echo "Chromium did not come up. Last log lines:" >&2
  pm logs --tail 20 "$CHROME" >&2 || true
  echo "If you see Wayland/permission errors, check: sudo ausearch -m avc -ts recent" >&2
  exit 1
fi
echo "Chromium ready."
if (( PG )); then
  ensure_postgres
  # An already-running agent cannot acquire a new secret mount or environment.
  if [[ $(cstate "$AGENT") == running ]] && ! pm exec "$AGENT" sh -c \
      '[ "${PGPASSFILE:-}" = /run/secrets/oc-pgpass ] && [ -r "$PGPASSFILE" ]' >/dev/null 2>&1; then
    echo "The running agent lacks the Postgres passfile; exit it and rerun with -p." >&2
    exit 1
  fi
fi
if (( DIND )); then ensure_dind; fi
for p in "${PORTS[@]}"; do echo "Port: http://127.0.0.1:${p%%:*} on the host -> 127.0.0.1:${p#*:} in pod '$POD'"; done
# Earlier builds that could not be removed while a container still ran them (e.g. Chromium before
# its recreation above).
prune_images

if (( NOLAUNCH )); then
  release_lifecycle_lock
  log "Setup complete for instance '$ILABEL' (-n: not launching OpenCode)."
  exit 0
fi

# ---- launch OpenCode ------------------------------------------------------------------
if (( MANAGED_MODE )); then
  if [[ $(cstate "$AGENT") == running ]] || any_relay_running "$POD"; then
    release_lifecycle_lock
    die "OpenCode or provider relay is already running in instance '$ILABEL'; exit it first"
  fi
  ensure_volume "$OPENAI_HOMEVOL" "$ILABEL"
  agent_pg=0
  if agent_pg_passfile; then agent_pg=1; fi
  dind_container_arg=""
  dind_run_arg=""
  if [[ $(cstate "$DINDC") != none ]]; then dind_container_arg=$DINDC dind_run_arg=$DINDRUN; fi
  pg_secret_arg=""
  pg_container_arg=""
  if (( agent_pg )); then pg_secret_arg=$PGPASSSECRET pg_container_arg=$PGC; fi
  relay_image_id=$(pm image inspect --format '{{.Id}}' "$RELAY_IMG") || die "missing relay image '$RELAY_IMG'"
  agent_image_id=$(pm image inspect --format '{{.Id}}' "$AGENT_IMG") || die "missing agent image '$AGENT_IMG'"
  session_helper=$SCRIPT_DIR/oc-openai-session.py
  verify_openai_helper "$session_helper"
  session_spec=$(/usr/bin/python3 -I -c '
import json, sys
keys = ("instance", "pod", "agent", "relay", "relay_image", "agent_image", "agent_mem",
        "level", "sandbox", "cwd", "home_vol", "chromium", "postgres", "pg_secret", "dind", "dind_run",
        "provider_filter", "cli_ui_mode")
print(json.dumps(dict(zip(keys, sys.argv[1:]))))
' "$ILABEL" "$POD" "$AGENT" "$RELAY" "$relay_image_id" "$agent_image_id" "$AGENT_MEM" \
  "$LEVEL" "$SB" "$CWD" "$OPENAI_HOMEVOL" "$CHROME" "$pg_container_arg" "$pg_secret_arg" "$dind_container_arg" "$dind_run_arg" \
  "$PROVIDER" "$CLI_UI_MODE")
  release_lifecycle_lock
  cd -- "$SCRIPT_DIR"
  log "Launching managed OpenCode (instance '$ILABEL') in /sandbox/$CWD"
  exec /usr/bin/env -i HOME="$HOME" TERM="${TERM:-xterm-256color}" PATH=/usr/bin:/bin \
    /usr/bin/python3 -IB "$session_helper" 3<<<"$session_spec"
fi
if any_relay_running "$POD"; then
  release_lifecycle_lock
  die "Provider relay is running in instance '$ILABEL'; exit the active provider session first"
fi
if ! remove_stale_relays "$POD"; then
  release_lifecycle_lock
  die "Could not verify or remove stopped provider relay in instance '$ILABEL'"
fi
if [[ $(cstate "$AGENT") == running ]]; then
  log "OpenCode is already running in instance '$ILABEL'; setup is up to date (acting like -n)."
  echo "Open a shell in it with:  ${0##*/}${INST:+ -i $INST} -x"
  release_lifecycle_lock
  exit 0
fi
agent_pg=0
if agent_pg_passfile; then agent_pg=1; fi
pm rm -f "$AGENT" >/dev/null 2>&1 || true
envargs=(-e "OC_INSTANCE=$ILABEL")
for v in "${FWD_ENV[@]}"; do [[ -n ${!v:-} ]] && envargs+=(-e "$v"); done
if (( agent_pg )); then
  envargs+=(--secret "$PGPASSSECRET",type=mount,target=/run/secrets/oc-pgpass,mode=0600 -e PGPASSFILE=/run/secrets/oc-pgpass)
fi
if [[ $(cstate "$DINDC") != none ]]; then
  envargs+=(-v "$DINDRUN":/run/dind -e DOCKER_HOST=unix:///run/dind/podman.sock
            -e CONTAINER_HOST=unix:///run/dind/podman.sock)
fi
log "Preparing OpenCode (instance '$ILABEL') in /sandbox/$CWD"
# Create while the lifecycle barrier is held; attach only after releasing it.
# No ':Z' on the shared mounts: relabel_shared already gave them this level (see above).
agent_id=$(pm create -it --rm --name "$AGENT" --pod "$POD" --label oc.sandbox=1 --label "oc.instance=$ILABEL" \
  --cap-drop=ALL --security-opt=no-new-privileges --security-opt "label=level:$LEVEL" \
  --pids-limit=512 --memory="$AGENT_MEM" \
  -v "$SB":/sandbox \
  -v "$HOMEVOL":/root \
  -w "/sandbox/$CWD" \
  "${envargs[@]}" \
  "$AGENT_IMG")
[[ $agent_id =~ ^[0-9a-f]{64}$ ]] || die "Podman did not return a complete agent container ID"
release_lifecycle_lock
log "Launching OpenCode (instance '$ILABEL') in /sandbox/$CWD"
exec "${H[@]}" podman start -ai "$agent_id"
