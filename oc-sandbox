# One SELinux level (MCS categories) shared by all agents, so several can use $SB at once; generated
# once per installation. Podman's ':Z' would give every agent a new level (cutting the others off)
# and would walk the agent-writable tree on the host; relabel_shared does it inside a container instead.
if [[ ! -s $STATE/sb-level ]]; then
  a=$((RANDOM % 1024)); b=$(( (a + 1 + RANDOM % 1023) % 1024 )); (( a < b )) || { t=$a; a=$b; b=$t; }
  printf 's0:c%d,c%d\n' "$a" "$b" | atomic_host_file "$STATE/sb-level" 0644
