# ---- images (rebuilt only when inputs change, or with -r) -------------------------
ensure_image() {  # name containerfile hash
  local name=$1 file=$2 want=$3 have
  have=$(pm image inspect --format '{{index .Labels "oc.hash"}}' "$name" 2>/dev/null || true)
  if (( REBUILD )) || [[ $have != "$want" ]]; then
    log "Building $name"
    pm build "${PULL[@]}" --label "oc.hash=$want" -t "$name" \
       -f "$BUILD/$file" "$BUILD"
  else
    echo "image $name up to date"
  fi
}
agent_hash=$(cd "$BUILD" && cat Containerfile.agent zshrc gitconfig gitignore_global bridge-open opencode-sandbox.json | sha256sum | cut -d' ' -f1)
chrome_hash=$(cd "$BUILD" && sha256sum Containerfile.chromium | cut -d' ' -f1)
PULL=(); (( REBUILD )) && PULL=(--pull=always)
ensure_image "$AGENT_IMG"  Containerfile.agent    "$agent_hash"
ensure_image "$CHROME_IMG" Containerfile.chromium "$chrome_hash"

ensure_volume() { pm volume exists "$1" 2>/dev/null \
  || pm volume create --label oc.sandbox=1 --label "oc.instance=$2" "$1" >/dev/null; }
ensure_volume "$HOMEVOL" shared
ensure_volume "$CHROMEVOL" "$ILABEL"

init_sandbox_tree "$CWD" "$WT_REPO" "$WT_BRANCH" \
  || { echo "could not prepare $SB/$CWD and $SB/.bridge (see above)" >&2; exit 1; }
