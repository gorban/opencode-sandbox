        dot_snapshot = snapshot_file(dot_fd)
        link = os.fsdecode(dot_snapshot[1]).strip()
        if not link.startswith("gitdir: "): fail("invalid existing worktree link")
        admin_path = os.path.normpath(os.path.join("/sandbox", dest, link[len("gitdir: "):]))
        prefix = "/sandbox/" + repo + "/.git/worktrees/"
        if not admin_path.startswith(prefix) or not re.fullmatch(r"[A-Za-z0-9._@+-]+", admin_path[len(prefix):]):
