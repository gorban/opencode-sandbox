cat > "$BUILD/bridge-open" <<'EOF'
#!/bin/sh
tool=$(basename "$0"); base=/sandbox/.bridge
[ -d "$base/requests" ] || { echo "$tool: $base/requests missing (is /sandbox mounted?)" >&2; exit 1; }
# copies of files from outside /sandbox (made below) are dropped after 7 days
find "$base/files" -mindepth 1 -maxdepth 1 -mtime +6 -exec rm -rf {} + 2>/dev/null
id=$(date +%s)-$$-$(od -An -N4 -tx1 /dev/urandom | tr -d ' ')
tmp="$base/tmp/$id"; printf '%s\n' "$tool" > "$tmp"
for a in "$@"; do
  case "$a" in -*) continue;; esac
  p=$(realpath "$a" 2>/dev/null) || continue
  case "$p" in
    /sandbox/*) ;;
    *) mkdir -p "$base/files/$id"; cp -a "$p" "$base/files/$id/" 2>/dev/null || continue
       p="$base/files/$id/$(basename "$p")";;
  esac
  printf '%s\n' "$p" >> "$tmp"
done
mv "$tmp" "$base/requests/$id.req"
EOF

