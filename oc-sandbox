#!/usr/bin/bash -p
# oc-sandbox — idempotent setup + launch + teardown for sandboxed OpenCode instances
# (one rootless Podman pod per instance: OpenCode agent + Chromium on your Wayland desktop,
# optional Postgres and docker-in-docker sidecar).
# Use the system Bash and skip startup hooks before checking the launcher and helper paths.
set -euo pipefail

if [[ ${1:-} == orchestrate ]]; then
  export PATH=/usr/bin:/bin
  IFS=: read -r _ _ orchestrator_uid _ _ HOME _ < <(/usr/bin/getent passwd "$EUID") || exit 2
  [[ $orchestrator_uid == "$EUID" && $HOME == /* ]] || exit 2
  export HOME
fi
CALLER_PWD=$PWD
CALLER_PHYSICAL=$(pwd -P)
SB="$HOME/opencode-sandbox"            # mounted at /sandbox in every agent
# This script runs on the HOST (and asks for admin rights), so it must never live inside the directory
# that is mounted into the agent containers, or an agent could rewrite it.
SCRIPT_REAL=$(/usr/bin/readlink -f -- "$0"); SCRIPT_DIR=${SCRIPT_REAL%/*}
case $SCRIPT_REAL in
  "$(/usr/bin/readlink -f -- "$SB")"/*)
    echo "Refusing to run: $SCRIPT_REAL is inside the sandbox directory $SB," >&2
    echo "which the agent can write to. Keep the checkout elsewhere (e.g. ~/code/opencode-sandbox)" >&2
    echo "and symlink it into ~/.local/bin. See README.md." >&2
    exit 1 ;;
esac
STATE="${XDG_DATA_HOME:-$HOME/.local/share}/oc-sandbox"
BUILD="$STATE/build"
BIN="$HOME/.local/bin"
UNITS="$HOME/.config/systemd/user"
UNITS_SOURCE=$UNITS
AGENT_IMG=oc-agent
CHROME_IMG=oc-chromium
RELAY_IMG=oc-openai-relay
# Images this script built, by full ID (one per line). Only those are ever removed by it: the tag
# names could belong to anything else, and labels prove nothing (any image built FROM oc-agent
# inherits them). The role label is informational only.
IMAGE_LOG="$STATE/built-images"
OWNER_LABEL=io.github.gorban.opencode-sandbox.image
DIND_IMG=${OC_DIND_IMAGE:-quay.io/podman/stable:latest}
HOMEVOL=oc-home                        # OpenCode login, sessions, self-updated binary: shared by all instances
CODE_BIN=${OC_CODE_BIN:-/home/linuxbrew/.linuxbrew/bin/code}   # host VS Code (override with OC_CODE_BIN)
BC_BIN=${OC_BCOMPARE_BIN:-/usr/bin/bcompare}                         # host Beyond Compare (override with OC_BCOMPARE_BIN)
AGENT_MEM=${OC_AGENT_MEMORY:-4g} CHROME_MEM=${OC_CHROMIUM_MEMORY:-4g} DIND_MEM=${OC_DIND_MEMORY:-4g}
FWD_ENV=(ANTHROPIC_API_KEY OPENAI_API_KEY OPENROUTER_API_KEY GEMINI_API_KEY GOOGLE_API_KEY)
# Pod ports that must never be published: a mapped connection reaches the pod as 127.0.0.1, which
# Chromium DevTools (9222, full browser control), pod-local provider relays (8401-8416), and Postgres
# (trust auth, any role) must never expose on host loopback.
SENSITIVE_PORTS=(9222 8401 8402 8403 8404 8405 8406 8407 8408 8409 8410 8411 8412 8413 8414 8415 8416)
RESERVED_NAMES=" agent chromium chrome postgres pg dind home openai-relay openai-home relay "

usage() {
  cat <<EOF
Usage: ${0##*/} [--mini|--no-mini] [--provider KIND[/LABEL]] [-i NAME] [-r] [-n] [-p] [-D] [-K] [-P HOST:POD]... [-C DIR] [-W REPO[:BRANCH]]
       ${0##*/} [-i NAME] -x | -l | -k | [-i NAME] -d [-a] [-y] | -h
       ${0##*/} openai {connect LABEL [--no-browser]|select LABEL|status|verify|disconnect [LABEL]}
       ${0##*/} orchestrate [--synthetic-check]
       ${0##*/} orchestrate --synthetic-check --provider claude

  (no flags)  Ensure everything exists (images, volumes, host bridge, pod, Chromium), then start
              OpenCode (defaulting to all enabled qualified providers when configured). Safe to run
              repeatedly; only missing/changed pieces are touched.
              If that instance's OpenCode is already running it only completes the setup (like -n).
  --mini      Launch OpenCode Mini (built-in minimal UI on the pinned OpenCode binary) instead of full OpenCode.
  --no-mini   Launch full OpenCode even when [launch].mini = true in ~/.config/oc-sandbox/providers.toml.
  --provider KIND[/LABEL]
              Restrict this launch to a single enabled, qualified provider instance (e.g. openai or openai/personal).
  -i NAME     Work on instance NAME (default: the "default" instance). Every instance has its own
              pod, Chromium (and profile), Postgres data and docker-in-docker storage, so several can
              run the same app on the same ports at once. Names: a-z, 0-9, '-'.
  -C DIR      Working directory, relative to $SB (default: construct for the default
              instance, wt/NAME for others). A named instance started inside a sandbox
              repository defaults to a worktree under wt/REPO/NAME. Created if missing.
  -W REPO[:BRANCH]
              Make the working directory a git worktree of $SB/REPO on BRANCH (default: the
              instance name; created from REPO's HEAD if it does not exist). Runs inside a container.
              Existing worktrees must match the requested repository and branch.
  -P PORT or HOST:POD  Publish a pod port on host loopback (repeatable, or comma-separated).
              Kept until changed; '-P none' removes all. Changing ports recreates the pod, which is
              refused while that instance's OpenCode runs. Ports 9222 and 8401-8416 are refused; 5432 requires -p.
  -p          Also run Postgres in the pod (data volume per instance, survives restarts and -d;
              only -d -a deletes it). There are NO defaults: configure image/user/password/database
              first (~/.config/oc-sandbox/postgres.env, postgres.NAME.env, or OC_PG_*). See README.md.
  -D          Also run a docker-in-docker sidecar (rootless Podman) in the pod; the agent gets
              'docker' / 'docker compose' (DOCKER_HOST). Weaker isolation than the agent: see README.md.
  -n          Setup only: do not launch OpenCode.
  -r          Rebuild images from latest bases and recreate the pod.
  -x          Open a zsh shell inside that instance's running OpenCode container.
  -l          List instances, including recorded worktree repository and branch.
  -k          List detected FIDO/U2F security keys (what would be passed to Chromium) and exit.
  -K          Do not pass any security key to Chromium on this run.
  -d          Delete: without -i, remove ALL instance pods and the host bridge; with -i, only that
              instance's pod. Keeps images, volumes and everything in $SB.
  -d -a       Also delete volumes (Chromium profile, Postgres data, docker storage; without -i also
              the OpenCode login, images, build files, SELinux module and $SB/.bridge).
  -y          Skip the confirmation prompt for -d -a.
  -h          This help.

Never touched: your files in $SB (including worktrees).
Inside OpenCode: 'code FILE' / 'bcompare A B' open copies on the host via a restricted bridge.
EOF
}
die() { echo "${0##*/}: $*" >&2; exit 2; }

# Host-trusted locations must lie outside $SB, which every agent can write: the state directory holds
# the image ledger (proof that an image may be deleted), the signature key, the SELinux level and
# build files; the config directory the Postgres password; plus the bridge binary and systemd units.
# Checking only the final resolved path is not enough: a path through an agent-owned symlink
# (XDG_DATA_HOME=$SB/xdg -> /elsewhere) resolves outside, and the agent swaps the link afterwards. So
# trusted_path walks the path like the kernel does, one component at a time, following every symlink,
# and fails if ANY step (including each symlink target on the way) is inside $SB. Only components
# outside $SB, which the agent cannot change, remain; the walked physical path is used from then on.
# The locations must not contain $SB either (-d -a deletes $STATE). Done before anything is touched.
sb_real=$(/usr/bin/realpath -m -- "$SB")
openai_sb_real=
in_sb() {
  [[ $1/ == "$sb_real"/* || ( -n ${openai_sb_real:-} && $1/ == "$openai_sb_real"/* ) ]]
}
trusted_path() {  # absolute path -> its physical path on stdout; 1 if the walk enters $SB
  local cur="" comp next t n=0 todo=() tc=()
  [[ $1 == /* && $1 != *$'\n'* && $1 != *$'\r'* ]] || return 1
  IFS=/ read -ra todo <<<"$1"
  while (( ${#todo[@]} )); do
    comp=${todo[0]}; todo=("${todo[@]:1}")
    case $comp in ""|.) continue ;; ..) cur=${cur%/*}; continue ;; esac
    next=$cur/$comp
    in_sb "$next" && return 1
    if [[ -L $next ]]; then
      (( ++n <= 40 )) || return 1
      IFS= read -r -d '' t < <(/usr/bin/readlink -z -- "$next") || return 1
      [[ $t != *$'\n'* && $t != *$'\r'* ]] || return 1
      tc=(); IFS=/ read -ra tc <<<"$t"
      [[ $t == /* ]] && cur=""
      todo=(${tc[@]+"${tc[@]}"} ${todo[@]+"${todo[@]}"})
    else cur=$next; fi
  done
  printf '%s\n' "${cur:-/}"
}
trusted_file() { # resolve repository helpers without following a path into the sandbox
  local r
  r=$(trusted_path "$1") || return 1
  [[ -f $r ]] || return 1
  printf '%s\n' "$r"
}

verify_openai_helper() {
  local helper=$1 account_entry account_uid account_home launcher source_file owner mode links source_parent private_source index
  local source_parents=()
  # Check the system account's sandbox too, independently of caller HOME.
  account_entry=$(/usr/bin/getent passwd "$EUID") || die "cannot verify the OpenAI workstation account"
  IFS=: read -r _ _ account_uid _ _ account_home _ <<<"$account_entry"
  [[ $account_uid == "$EUID" && $account_home == /* ]] || die "invalid OpenAI workstation account"
  openai_sb_real=$(/usr/bin/realpath -m -- "$account_home/opencode-sandbox") ||
    die "cannot verify the OpenAI workstation sandbox path"
  launcher=$0
  [[ $launcher == /* ]] || launcher=$CALLER_PHYSICAL/$launcher
  [[ $(trusted_path "$launcher") == "$SCRIPT_REAL" && -f $SCRIPT_REAL ]] ||
    die "refusing an unsafe OpenAI launcher path"
  [[ $(trusted_file "$helper") == "$helper" && ! -L $helper ]] ||
    die "refusing an unsafe OpenAI helper path"
  for source_file in "$SCRIPT_REAL" "$helper"; do
    read -r owner mode links < <(/usr/bin/stat -c '%u %a %h' -- "$source_file") ||
      die "cannot verify OpenAI source ownership"
    (( (owner == EUID || owner == 0) && !(8#$mode & 022) && links == 1 )) ||
      die "refusing unprotected OpenAI source"
  done
  source_parent=$SCRIPT_DIR
  while :; do
    source_parents+=("$source_parent")
    [[ $source_parent != / ]] || break
    source_parent=${source_parent%/*}
    source_parent=${source_parent:-/}
  done
  # A private, user-owned ancestor already excludes other users from its subtree.
  private_source=0
  for (( index=${#source_parents[@]}-1; index>=0; index-- )); do
    source_parent=${source_parents[index]}
    read -r owner mode < <(/usr/bin/stat -c '%u %a' -- "$source_parent") ||
      die "cannot verify OpenAI source directory"
    if [[ $source_parent != /tmp ]] || (( (owner != 0 && owner != 65534) || !(8#$mode & 01000) )); then
      (( (owner == EUID || owner == 0) && (private_source || !(8#$mode & 022)) )) ||
        die "refusing unprotected OpenAI source directory"
    fi
    if (( owner == EUID && !(8#$mode & 077) )); then private_source=1; fi
  done
}

if [[ ${1:-} == openai ]]; then
  case $#:${2:-} in
    2:status|2:verify|2:disconnect) ;;
    3:connect|4:connect)
      [[ $# != 4 || $4 == --no-browser ]] ||
        die "usage: oc-sandbox openai connect LABEL [--no-browser]"
      LC_ALL=C
      [[ ${#3} -le 32 && $3 =~ ^[a-z][a-z0-9]*(-[a-z0-9]+)*$ ]] ||
        die "OpenAI labels must be 1 to 32 ASCII lowercase letters, numbers, or single inner hyphens, starting with a letter"
      ;;
    3:select|3:disconnect)
      LC_ALL=C
      [[ $3 =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$ ]] ||
        die "OpenAI labels must be 1 to 32 ASCII letters, numbers, underscores or hyphens, starting with a letter or number"
      ;;
    *) die "usage: oc-sandbox openai {connect LABEL [--no-browser]|select LABEL|status|verify|disconnect [LABEL]}" ;;
  esac
  helper=$SCRIPT_DIR/oc-openai.py
  verify_openai_helper "$helper"
  cd -- "$SCRIPT_DIR"
  shift
  exec /usr/bin/env -i HOME="$HOME" PATH=/usr/bin:/bin /usr/bin/python3 -IB "$helper" "$@"
fi

if [[ ${1:-} == orchestrate ]]; then
  shift
  orchestrator_source=$0
  if [[ $orchestrator_source != /* ]]; then orchestrator_source=$CALLER_PHYSICAL/$orchestrator_source; fi
  [[ $(trusted_file "$orchestrator_source") == "$SCRIPT_REAL" ]] || die "untrusted orchestrator entry"
  orchestrator_helper=$(trusted_file "$SCRIPT_DIR/oc-orchestrate.py") || die "unavailable orchestrator launcher"
  orchestrator_host=local
  if [[ -n ${CONTAINER_ID:-} ]]; then orchestrator_host=distrobox; fi
  exec /usr/bin/env -i PATH=/usr/bin:/bin LANG=C.UTF-8 \
    /usr/bin/python3 -IB "$orchestrator_helper" "$orchestrator_host" "$@"
fi
trusted_dir() {  # VAR path: set VAR to the checked physical path, or die
  local r
  r=$(trusted_path "$2") || die "refusing to use $2: the path leads into the sandbox directory $SB, which the agent controls (check XDG_DATA_HOME / XDG_CONFIG_HOME and symlinks)"
  [[ $sb_real/ != "${r%/}"/* ]] || die "refusing to use $2: the sandbox directory $SB is inside it ($r)"
  printf -v "$1" '%s' "$r"
}
trusted_dir STATE "$STATE"
trusted_dir CONF_DIR "${XDG_CONFIG_HOME:-$HOME/.config}/oc-sandbox"
trusted_dir BIN "$BIN"
trusted_dir UNITS "$UNITS"
trusted_dir INSTALL_DIR "$UNITS/.oc-sandbox"
trusted_dir BUILD "$STATE/build"
trusted_dir POLDIR "$STATE/policy"
trusted_dir BRIDGE_STAGE "$STATE/bridge-stage"
IMAGE_LOG="$STATE/built-images"

# Agent-writable files may have been linked into previously created host state.
# Validate each script-owned leaf before even listing or deleting state. Parent
# directories must prevent other users replacing entries between checks and use.
validate_host_state() {
  local scope=${1:-}
  local paths=("$STATE" "$BUILD" "$POLDIR" "$BRIDGE_STAGE" "$BIN" "$UNITS" "$INSTALL_DIR")
  if [[ -n $scope ]]; then paths=("$2"); fi
  if [[ $scope == host ]]; then host_python - "$scope" "${paths[@]}"
  else /usr/bin/python3 -I - "$scope" "${paths[@]}"; fi <<'PYCODE'
import os, stat, sys
scope, *paths = sys.argv[1:]
uid = os.geteuid()
def directory(path, owned=False):
    path = os.path.normpath(path)
    current = path
    nearest = None
    while True:
        try: st = os.lstat(current)
        except FileNotFoundError: pass
        else:
            if not stat.S_ISDIR(st.st_mode): raise ValueError("not a real directory: " + current)
            if nearest is None:
                if st.st_uid != uid or st.st_mode & 0o022:
                    raise ValueError("nearest host state parent is not owned and protected: " + current)
                nearest = (st.st_dev, st.st_ino, os.path.relpath(path, current))
            # A sticky shared ancestor such as /tmp cannot be used to replace an
            # entry owned by this user; the actual script-owned directories remain private.
            sticky_ancestor = (current != path and st.st_uid in (0, 65534)
                               and bool(st.st_mode & stat.S_ISVTX))
            if st.st_uid not in (uid, 0) and not sticky_ancestor: raise ValueError("directory has unsafe owner: " + current)
            if st.st_mode & 0o022 and not sticky_ancestor: raise ValueError("directory is writable by other users: " + current)
            if current == path and owned and st.st_uid != uid: raise ValueError("directory is not owned by this user: " + current)
        parent = os.path.dirname(current)
        if parent == current: break
        current = parent
    return nearest
def leaf(path, private=False):
    try: st = os.lstat(path)
    except FileNotFoundError: return
    if (not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_nlink != 1 or st.st_mode & 0o022
        or (private and stat.S_IMODE(st.st_mode) != 0o600)):
        raise ValueError("unsafe host state file: " + path)
try:
    if scope:
        print(directory(paths[0], True))
        sys.exit(0)
    state, build, policy, stage, binary, units, install = paths
    for path in paths: directory(path, True)
    for name in ("sb-level", "built-images", "built-images.lock", "pg-sig.key", "pg-sig.lock"):
        leaf(os.path.join(state, name), name in ("pg-sig.key", "pg-sig.lock"))
    for name in ("Containerfile.agent", "Containerfile.chromium", "Containerfile.relay", "opencode-sandbox.json", "zshrc", "bridge-open", "gitconfig", "gitignore_global", "oc-opencode-update.py", "oc-opencode-run.py"):
        leaf(os.path.join(build, name))
    for name in ("oc_chromium.cil", "installed"): leaf(os.path.join(policy, name))
    for name in ("oc-bridge.service", "oc-bridge.path", "oc-bridge.timer"): leaf(os.path.join(units, name))
    leaf(os.path.join(install, "binding"), private=True)
    leaf(os.path.join(binary, "oc-bridge"))
except (OSError, ValueError) as exc:
    print("unsafe host state: " + str(exc), file=sys.stderr); sys.exit(2)
PYCODE
}
validate_host_state || die "refusing unsafe host state"
# Write script-owned files by replacement, never by following a destination link.
atomic_host_file() {  # destination, mode; contents on stdin
  local target=$1 mode=$2 tmp rc=0
  tmp=$(mktemp "${target%/*}/.oc-write.XXXXXXXX") || return 1
  chmod "$mode" "$tmp" && cat > "$tmp" && mv -f -- "$tmp" "$target" || rc=$?
  [[ ! -e $tmp ]] || rm -f -- "$tmp"
  return "$rc"
}

# ---- option parsing ---------------------------------------------------------
DELETE=0 ALL=0 REBUILD=0 NOLAUNCH=0 YES=0 LISTKEYS=0 NOKEY=0 EXEC=0 PG=0 DIND=0 LIST=0
INST="" INST_SET=0 CWD_ARG="" WT_ARG="" PORT_ARGS=() PROVIDER="" PROVIDER_SET=0
CLI_UI_MODE="default" UI_MODE_SET=0
GETOPTS_ARGS=()
while (( $# )); do
  case $1 in
    --mini)
      (( !UI_MODE_SET )) || die "--mini and --no-mini may only be specified once"
      CLI_UI_MODE="mini" UI_MODE_SET=1
      shift
      ;;
    --no-mini)
      (( !UI_MODE_SET )) || die "--mini and --no-mini may only be specified once"
      CLI_UI_MODE="full" UI_MODE_SET=1
      shift
      ;;
    --provider)
      (( !PROVIDER_SET )) || die "--provider may only be specified once"
      (( $# >= 2 )) && [[ -n $2 ]] || die "--provider needs a value (openai or openai/LABEL)"
      PROVIDER=$2 PROVIDER_SET=1
      shift 2
      ;;
    --provider=*)
      (( !PROVIDER_SET )) || die "--provider may only be specified once"
      PROVIDER=${1#--provider=}
      [[ -n $PROVIDER ]] || die "--provider needs a value (openai or openai/LABEL)"
      PROVIDER_SET=1
      shift
      ;;
    --)
      GETOPTS_ARGS+=("$@")
      break
      ;;
    --*)
      die "unknown option: $1"
      ;;
    *)
      GETOPTS_ARGS+=("$1")
      shift
      ;;
  esac
done
if [[ -n $PROVIDER ]]; then
  provider_kind=${PROVIDER%%/*}
  provider_inst=""
  if [[ $PROVIDER == */* ]]; then
    provider_inst=${PROVIDER#*/}
    [[ $provider_inst != */* ]] || die "invalid --provider target '$PROVIDER'"
    LC_ALL=C
    [[ ${#provider_inst} -le 32 && $provider_inst =~ ^[a-z][a-z0-9]*(-[a-z0-9]+)*$ ]] ||
      die "invalid provider instance label '$provider_inst'"
  fi
  case $provider_kind in
    openai) ;;
    claude|google) die "--provider $PROVIDER is not yet qualified for sandbox launch" ;;
    *) die "unsupported provider '$PROVIDER' (supported: openai)" ;;
  esac
fi
set -- ${GETOPTS_ARGS[@]+"${GETOPTS_ARGS[@]}"}
while getopts ":hdarnykKxplDi:P:C:W:" o; do
  case $o in
    h) usage; exit 0 ;;
    d) DELETE=1 ;; a) ALL=1 ;; r) REBUILD=1 ;; n) NOLAUNCH=1 ;; y) YES=1 ;;
    k) LISTKEYS=1 ;; K) NOKEY=1 ;; x) EXEC=1 ;; p) PG=1 ;; D) DIND=1 ;; l) LIST=1 ;;
    i) INST=$OPTARG INST_SET=1 ;; P) PORT_ARGS+=("$OPTARG") ;; C) CWD_ARG=$OPTARG ;; W) WT_ARG=$OPTARG ;;
    :) die "-$OPTARG needs a value" ;;
    *) usage >&2; exit 2 ;;
  esac
done
(( OPTIND > $# )) || die "unexpected argument: ${!OPTIND}"
if [[ -n $PROVIDER ]] && (( DELETE || NOLAUNCH || EXEC || LIST || LISTKEYS )); then
  die "--provider cannot be combined with -n, -d, -x, -l or -k"
fi
if (( UI_MODE_SET )) && (( DELETE || NOLAUNCH || EXEC || LIST || LISTKEYS )); then
  die "--mini/--no-mini cannot be combined with -n, -d, -x, -l or -k"
fi
if (( ALL && !DELETE )); then die "-a only makes sense with -d"; fi
if (( DELETE || EXEC || LIST || LISTKEYS )) && { (( PG || DIND || ${#PORT_ARGS[@]} )) || [[ -n $CWD_ARG$WT_ARG ]]; }; then
  die "-p, -D, -P, -C and -W only apply when setting up or starting an instance"
fi

detect_managed_mode() {  # 0 if managed mode required, 1 if confirmed absent in both account and caller homes
  (( PROVIDER_SET || UI_MODE_SET )) && return 0
  local rc=0
  /usr/bin/python3 -I - "$HOME" <<'PYCODE' || rc=$?
import os, pwd, stat, sys
def inspect_base(base):
    if not base or not base.startswith("/"):
        return 2
    cfg = os.path.join(base, ".config")
    try:
        st = os.lstat(cfg)
    except FileNotFoundError:
        return 0
    except OSError:
        return 2
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
        return 1
    oc_dir = os.path.join(cfg, "oc-sandbox")
    try:
        st = os.lstat(oc_dir)
    except FileNotFoundError:
        return 0
    except OSError:
        return 2
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
        return 1
    for leaf in ("providers.toml", "openai"):
        try:
            os.lstat(os.path.join(oc_dir, leaf))
            return 1
        except FileNotFoundError:
            continue
        except OSError:
            return 2
    return 0
try:
    account_home = pwd.getpwuid(os.geteuid()).pw_dir
except KeyError:
    sys.exit(2)
if not account_home or not account_home.startswith("/"):
    sys.exit(2)
found = False
for base in dict.fromkeys((account_home, sys.argv[1])):
    status = inspect_base(base)
    if status == 2:
        sys.exit(2)
    if status == 1:
        found = True
sys.exit(1 if found else 0)
PYCODE
  case $rc in
    0) return 1 ;;
    1) return 0 ;;
    *) die "cannot verify provider configuration state in account home" ;;
  esac
}

MANAGED_MODE=0
if (( !DELETE && !LIST && !EXEC && !LISTKEYS )) && detect_managed_mode; then
  MANAGED_MODE=1
fi

# ---- names ----------------------------------------------------------------------------------------
valid_instance() {  # named instance, excluding the alias for the default instance
  [[ $1 != default && $1 =~ ^[a-z0-9]([a-z0-9-]{0,22}[a-z0-9])?$ && ! $1 =~ ^relay(-[0-9]+)?$ && $RESERVED_NAMES != *" $1 "* ]]
}
# INST_SET records that -i was given at all: "-i default" selects the default instance only and must
# never fall through to the all-instances scope of a bare -d (or -d -a).
if (( INST_SET )) && [[ -z $INST ]]; then die "-i needs an instance name (use 'default' for the default instance)"; fi
[[ $INST == default ]] && INST=""
[[ -z $INST ]] || valid_instance "$INST" \
  || die "invalid instance name '$INST' (a-z, 0-9 and inner '-', at most 24 characters; not one of:$RESERVED_NAMES)"
set_names() {  # derive every per-instance resource name; the default instance keeps the original names
  local p
  if [[ -z $INST ]]; then p=oc ILABEL=default DEFAULT_CWD=construct POD=oc; else p=oc-$INST ILABEL=$INST DEFAULT_CWD=wt/$INST POD=$p; fi
  AGENT=$p-agent CHROME=$p-chromium PGC=$p-postgres DINDC=$p-dind RELAY=$p-openai-relay
  CHROMEVOL=$p-chrome PGVOL=$p-pg PGSECRET=$p-pg-password PGPASSSECRET=$p-pg-passfile PGHBASECRET=$p-pg-hba DINDVOL=$p-dind DINDRUN=$p-dind-run OPENAI_HOMEVOL=$p-openai-home
}
