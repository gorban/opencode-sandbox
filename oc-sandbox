inspect_pg_init() { # host only; output the existing digest, or no line for an absent or empty tree
  local dir=$1 entries invalid owner_id digest
  [[ -e $dir ]] || return 0
  [[ -d $dir ]] || { echo "Postgres init path is not a directory" >&2; return 1; }
  entries=$(find "$dir" -mindepth 1 -printf x -quit) || return 1
  [[ -n $entries ]] || return 0
  owner_id=$(id -u) || return 1
  invalid=$(find "$dir" \( ! -type d ! -type f -o -type f -links +1 \
    -o \( ! -uid "$owner_id" ! -uid 0 \) -o -perm /022 \) -printf x -quit) || return 1
  [[ -z $invalid ]] || {
    echo "Postgres init requires ordinary owner-controlled directories and files without links" >&2
    return 1
  }
  # Keep the original inner sha256sum even for an init tree without files.
  digest=$(cd "$dir" && find . -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -c1-16) \
    || return 1
  printf '%s\n' "$digest"
}

shared_host_directory() {
  local caller_path=$1 description=$2 host_source=${3:-$1} host_path caller host
  if (( ! ${#H[@]} )); then printf '%s\n' "$caller_path"; return; fi
  host_path=$(host_input bridge-stage "$host_source") || die "unsafe host $description directory"
  caller=$(validate_host_state caller "$caller_path") || die "unsafe launcher $description directory"
  host=$(validate_host_state host "$host_path") || die "unsafe host $description directory"
  [[ -n $host && $caller == "$host" ]] || die "launcher and host see different $description directories"
  printf '%s\n' "$host_path"
}

verify_bridge_stage() {
