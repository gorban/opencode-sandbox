# ---- SELinux policy: dedicated type so ONLY the Chromium containers may use the Wayland socket ----
POLDIR="$STATE/policy"; TPL=/usr/share/udica/templates
mkdir -p "$POLDIR"
cat > "$POLDIR/oc_chromium.cil" <<'POL'
; SELinux type for the sandboxed Chromium container only (oc_chromium.process).
(block oc_chromium
    (blockinherit container)
    (blockinherit net_container)
    (allow process process (capability (dac_override)))
    ; use the host Wayland compositor socket (KWin runs unconfined_t)
    (allow process unconfined_t (unix_stream_socket (connectto)))
    (allow process unconfined_t (fd (use)))
    (allow process user_tmp_t (sock_file (write getattr append open)))
    ; shared-memory buffers passed over the Wayland socket
    (allow process user_tmp_t (file (read write open getattr map)))
    (allow process tmpfs_t (file (open map)))
    (allow process proc_t (filesystem (associate)))
    ; FIDO security key (hidraw node passed with --device) + udev database for device enumeration
    (allow process usb_device_t (chr_file (read write open getattr ioctl)))
    (allow process udev_var_run_t (dir (search open read getattr)))
    (allow process udev_var_run_t (file (read open getattr)))
)
POL
pol_hash=$(sha256sum "$POLDIR/oc_chromium.cil" | cut -c1-16)
if [[ $(cat "$POLDIR/installed" 2>/dev/null || true) != "$pol_hash" ]]; then
  log "Installing SELinux policy module oc_chromium (asks for your admin password)"
  "${H[@]}" test -f "$TPL/base_container.cil" \
    || { echo "udica templates missing ($TPL); install the 'udica' package" >&2; exit 1; }
  if "${H[@]}" pkexec semodule -i "$POLDIR/oc_chromium.cil" "$TPL/base_container.cil" "$TPL/net_container.cil" \
     || "${H[@]}" sudo semodule -i "$POLDIR/oc_chromium.cil" "$TPL/base_container.cil" "$TPL/net_container.cil"; then
    echo "$pol_hash" > "$POLDIR/installed"
  else
    echo "Policy install failed; Chromium cannot reach the Wayland socket without it." >&2; exit 1
  fi
fi

# Keyed hash of the settings Postgres only reads when its volume is created. The key (random, mode
# 0600, outside the sandbox) keeps the volume label from being an offline guessable hash of the password.
pg_sig() {
  local key=$STATE/pg-sig.key
  if [[ ! -s $key ]]; then
    (umask 077; mkdir -p "$STATE"; od -An -N32 -tx1 /dev/urandom | tr -d ' \n' > "$key")
  fi
  { cat "$key"; printf '|%s|%s|%s|%s' "$PG_USER" "$PG_PASSWORD" "$PG_DB" "$1"; } | sha256sum | cut -c1-16
}

ensure_postgres() {
  local pg_state pg_cfg want_cfg sig legacy vsig init_hash="" ok=0
  local pgargs=()
  if [[ -d $PG_INIT ]] && [[ -n $(ls -A "$PG_INIT" 2>/dev/null) ]]; then
    init_hash=$(cd "$PG_INIT" && find . -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -c1-16)
    pgargs+=(-v "$PG_INIT:/docker-entrypoint-initdb.d:ro,Z")
  fi
  # Postgres only reads user/password/db/init scripts when the data volume is first created, so the
  # volume remembers the settings it was created with; a mismatch is refused instead of silently ignored.
  sig=k1:$(pg_sig "$init_hash")
  if pm volume exists "$PGVOL" 2>/dev/null; then
    vsig=$(pm volume inspect "$PGVOL" --format '{{index .Labels "oc.pgcfg"}}' 2>/dev/null || true)
    # volumes made by earlier versions carry an unkeyed hash: still accepted, with a notice
    legacy=$(printf '%s|%s|%s|%s' "$PG_USER" "$PG_PASSWORD" "$PG_DB" "$init_hash" | sha256sum | cut -c1-16)
    if [[ $vsig == "$legacy" ]]; then
      echo "note: volume '$PGVOL' (made by an older oc-sandbox) is labelled with an unkeyed hash of the" >&2
      echo "      Postgres settings; recreate it when convenient: ${0##*/} -i $ILABEL -d && podman volume rm $PGVOL" >&2
    elif [[ $vsig != "$sig" ]]; then
      if [[ -z $vsig ]]; then
        echo "Volume '$PGVOL' has no recorded Postgres settings (created by an older version)." >&2
      else
        echo "Postgres settings changed since volume '$PGVOL' was created (user/password/database/init scripts)," >&2
        echo "or $STATE/pg-sig.key was deleted." >&2
      fi
      echo "Postgres ignores those settings on an existing volume. To apply them, discard the data first:" >&2
      # always '-i NAME' (also '-i default'): a bare -d would remove every instance and the bridge
      echo "    ${0##*/} -i $ILABEL -d && podman volume rm $PGVOL     # then rerun with -p" >&2
      exit 1
    fi
  else
    pm volume create --label oc.sandbox=1 --label "oc.instance=$ILABEL" --label "oc.pgcfg=$sig" "$PGVOL" >/dev/null
  fi

  want_cfg="v2:$sig:$PG_IMAGE"
  pg_state=$(cstate "$PGC")
  pg_cfg=$(pm container inspect --format '{{index .Config.Labels "oc.pg"}}' "$PGC" 2>/dev/null || true)
  if [[ $pg_state != none && $pg_cfg != "$want_cfg" ]]; then
    log "Postgres container settings changed; recreating it (data volume $PGVOL is kept)"
    pm rm -f "$PGC" >/dev/null; pg_state=none
  fi
  case $pg_state in
    running) echo "Postgres already running." ;;
    none)
      log "Creating Postgres in pod '$POD' (image $PG_IMAGE, volume $PGVOL)"
      # The password goes over stdin into a Podman secret and is mounted as a file: it never appears
      # in any argv, in the container's environment, or in 'podman inspect'.
      printf '%s' "$PG_PASSWORD" | pm secret create --replace "$PGSECRET" - >/dev/null
      pm run -d --name "$PGC" --pod "$POD" --label "oc.pg=$want_cfg" --security-opt=no-new-privileges \
        --cap-drop=ALL --cap-add=CHOWN --cap-add=SETUID --cap-add=SETGID \
        --cap-add=FOWNER --cap-add=DAC_OVERRIDE \
        --pids-limit=256 --memory=2g \
        -v "$PGVOL":/var/lib/postgresql/data:Z "${pgargs[@]}" \
        --secret "$PGSECRET",type=mount,target=/run/secrets/postgres-password \
        -e POSTGRES_PASSWORD_FILE=/run/secrets/postgres-password \
        -e POSTGRES_USER="$PG_USER" -e POSTGRES_DB="$PG_DB" \
        "$PG_IMAGE" -c listen_addresses=127.0.0.1 >/dev/null ;;
    *) log "Starting existing Postgres container (data kept in volume $PGVOL)"
       pm start "$PGC" >/dev/null ;;
  esac
  for _ in $(seq 1 60); do
    pm exec "$PGC" pg_isready -h 127.0.0.1 -U "$PG_USER" -d "$PG_DB" -q 2>/dev/null && { ok=1; break; }
    sleep 1
  done
  (( ok )) || { echo "Postgres did not become ready:" >&2; pm logs --tail 15 "$PGC" >&2; exit 1; }
  echo "Postgres ready (inside pod '$POD' only, not reachable from the host, the LAN or other instances)."
  echo "  psql -h 127.0.0.1 -U $PG_USER -d $PG_DB     # no password needed on localhost with the standard images"
  echo "  DATABASE_URL=postgres://$(urlenc "$PG_USER")@127.0.0.1:5432/$(urlenc "$PG_DB")"
}

urlenc() {  # percent-encode for a URL component (byte-wise, so UTF-8 comes out right)
  local LC_ALL=C s=$1 out='' c i
  for (( i = 0; i < ${#s}; i++ )); do
    c=${s:i:1}
    case $c in [A-Za-z0-9._~-]) out+=$c ;; *) printf -v c '%%%02X' "'$c"; out+=$c ;; esac
  done
  printf '%s' "$out"
}

# Docker-in-docker: rootless Podman in a sidecar, reachable by the agent only through a socket in a
# small per-instance volume. It needs what nested rootless containers need (default capabilities,
# setuid newuidmap, /dev/fuse, /dev/net/tun) and runs SELinux-unconfined (label=disable): weaker than
# the agent, hence opt-in. Nested containers share the pod's network with --network host.
ensure_dind() {
  local want="v1:$DIND_IMG" have state ok=0 pull=()
  (( REBUILD )) && pull=(--pull=newer)
  state=$(cstate "$DINDC")
  have=$(pm container inspect --format '{{index .Config.Labels "oc.dind"}}' "$DINDC" 2>/dev/null || true)
  if [[ $state != none && $have != "$want" ]]; then
    log "docker-in-docker settings changed; recreating it (storage volume $DINDVOL is kept)"
    pm rm -f "$DINDC" >/dev/null; state=none
  fi
  ensure_volume "$DINDVOL" "$ILABEL"; ensure_volume "$DINDRUN" "$ILABEL"
  case $state in
    running) echo "docker-in-docker already running." ;;
    none)
      log "Starting docker-in-docker sidecar in pod '$POD' (image $DIND_IMG, storage $DINDVOL)"
      pm run -d "${pull[@]}" --name "$DINDC" --pod "$POD" --label "oc.dind=$want" \
        --user podman --device /dev/fuse --device /dev/net/tun --security-opt label=disable \
        --pids-limit=4096 --memory="$DIND_MEM" \
        -v "$DINDVOL":/home/podman/.local/share/containers -v "$DINDRUN":/run/dind:U -v "$SB":/sandbox:ro \
        "$DIND_IMG" sh -c 's=/run/dind/podman.sock; rm -f $s
          podman system service --time=0 unix://$s & i=0
          while [ ! -S $s ] && [ $i -lt 300 ]; do sleep 0.1; i=$((i + 1)); done
          chmod 0666 $s; wait' >/dev/null ;;
    *) log "Starting existing docker-in-docker sidecar"; pm start "$DINDC" >/dev/null ;;
  esac
  for _ in $(seq 1 60); do
    pm exec "$DINDC" curl -sf --unix-socket /run/dind/podman.sock http://d/_ping >/dev/null 2>&1 && { ok=1; break; }
    sleep 1
  done
  (( ok )) || { echo "docker-in-docker did not become ready:" >&2; pm logs --tail 15 "$DINDC" >&2; exit 1; }
  echo "docker-in-docker ready: 'docker run --network host ...' shares this pod's network (127.0.0.1)."
}

# ---- pod ------------------------------------------------------------------------------------------
# Every pod gets pasta's --host-lo-to-ns-lo (published ports reach apps bound to 127.0.0.1 in the pod)
# and an unprivileged-port sysctl scoped to the pod's network namespace (apps may bind ports < 1024
# without NET_BIND_SERVICE). Ports are fixed at pod creation; the label records them.
pod_exists() { pm pod exists "$POD" 2>/dev/null; }
if pod_exists && (( !PORTS_SET )); then
  have_ports=$(pm pod inspect "$POD" --format '{{index .Labels "oc.ports"}}' 2>/dev/null || true)
  if [[ -n $have_ports ]]; then IFS=, read -ra PORTS <<<"$have_ports"; fi
fi
want_podcfg="v1|$(ports_label)"
recreate=""
if pod_exists; then
  have_podcfg=$(pm pod inspect "$POD" --format '{{index .Labels "oc.podcfg"}}' 2>/dev/null || true)
  if (( REBUILD )); then recreate="rebuild (-r)"
  elif (( PORTS_SET )) && [[ $have_podcfg != "$want_podcfg" ]]; then recreate="port mapping changed"
  fi
fi
if [[ -n $recreate ]]; then
  if [[ $(cstate "$AGENT") == running ]]; then
    echo "Cannot recreate pod '$POD' ($recreate): OpenCode is running in instance '$ILABEL'." >&2
    echo "Exit it first, then rerun this command." >&2
    exit 1
  fi
  # keep the sidecars this instance had (their data lives in volumes)
  if [[ $(cstate "$PGC") != none ]] && (( !PG )); then PG=1; load_pg_config; fi
  [[ $(cstate "$DINDC") != none ]] && DIND=1
  log "Recreating pod '$POD' ($recreate)"
  pm pod rm -f "$POD" >/dev/null
fi
if ! pod_exists; then
  log "Creating pod '$POD'${PORTS[*]:+ (ports: $(ports_label))}"
  podargs=()
  for p in "${PORTS[@]}"; do podargs+=(-p "127.0.0.1:$p"); done
  pm pod create --name "$POD" --label oc.sandbox=1 --label "oc.instance=$ILABEL" \
    --label "oc.podcfg=$want_podcfg" --label "oc.ports=$(ports_label)" \
    --network pasta:--host-lo-to-ns-lo --sysctl net.ipv4.ip_unprivileged_port_start=0 \
    "${podargs[@]}" >/dev/null
fi

# ---- Chromium ---------------------------------------------------------------------------------------
want_id=$(pm image inspect --format '{{.Id}}' "$CHROME_IMG")
have_id=$(pm container inspect --format '{{.Image}}' "$CHROME" 2>/dev/null || true)
have_cfg=$(pm container inspect --format '{{index .Config.Labels "oc.cfg"}}' "$CHROME" 2>/dev/null || true)
# Security keys: pass ONLY FIDO hidraw nodes (see detect_keys); -K disables.
keys=""
if (( NOKEY )); then echo "Security keys: disabled (-K)"; else keys=$(detect_keys); fi
fido_nodes=$(printf '%s\n' "$keys" | cut -d'|' -f1 | grep . || true)
devargs=()
for n in $fido_nodes; do devargs+=(--device "$n"); done
(( ${#devargs[@]} )) && devargs+=(-v /run/udev:/run/udev:ro)   # Chromium enumerates HID via udev
while IFS='|' read -r node name id; do
  [[ -n $node ]] && echo "Security key: $name [$id] -> $node"
done <<<"$keys"
(( NOKEY )) || [[ -n $keys ]] || echo "Security key: none detected (plug one in and rerun to use it)"
# A named instance opens a first tab titled with its name, so its window is easy to tell apart.
starturl=()
[[ -n $INST ]] && starturl=("data:text/html,%3Ctitle%3Eoc%20$INST%3C/title%3E%3Ch1%3Eoc-sandbox%20instance%20$INST%3C/h1%3E")
# recreate the container only if its run command, policy, or security-key set changed
cfg=$( { sed -n '/^# >>>chromium-run/,/^# <<<chromium-run/p' "$SCRIPT_REAL"; echo "$fido_nodes"; cat "$POLDIR/oc_chromium.cil"; } | sha256sum | cut -c1-16)
if [[ -n $have_id && ( $have_id != "$want_id" || $have_cfg != "$cfg" ) ]]; then
  log "Chromium image/config changed; recreating container"
  pm rm -f "$CHROME" >/dev/null
  have_id=
fi
if [[ -z $have_id ]]; then
  # A crash/reboot leaves SingletonLock naming the old pod's hostname; Chromium then refuses the profile.
  # No Chromium container for this instance exists at this point, so clearing the locks is safe.
  pm run --rm --entrypoint sh --cap-drop=ALL --cap-add=DAC_OVERRIDE -v "$CHROMEVOL":/profile:Z "$CHROME_IMG" \
     -c 'rm -f /profile/SingletonLock /profile/SingletonCookie /profile/SingletonSocket' >/dev/null 2>&1 || true
  log "Starting Chromium"
  # DAC_OVERRIDE: Chromium's crashpad handler aborts without it under --cap-drop=ALL.
  # label type oc_chromium.process: custom SELinux type (see policy dir) that may use the Wayland socket.
# >>>chromium-run
  pm run -d --name "$CHROME" --pod "$POD" --label "oc.cfg=$cfg" \
    --cap-drop=ALL --cap-add=DAC_OVERRIDE --security-opt=no-new-privileges \
    --security-opt label=type:oc_chromium.process \
    --pids-limit=1024 --memory="$CHROME_MEM" --shm-size=1g \
    -v "$CHROMEVOL":/profile:Z \
    "${devargs[@]}" \
    -v "$WL":/run/xdg/wayland-1 \
    -e XDG_RUNTIME_DIR=/run/xdg -e WAYLAND_DISPLAY=wayland-1 \
    "$CHROME_IMG" \
    chromium-browser --ozone-platform=wayland --no-sandbox --disable-gpu \
      --no-first-run --no-default-browser-check --class="oc-$ILABEL" \
      --user-data-dir=/profile --remote-debugging-port=9222 "${starturl[@]}" >/dev/null
# <<<chromium-run
elif [[ $(cstate "$CHROME") != running ]]; then
  log "Starting existing Chromium container"
  pm start "$CHROME" >/dev/null
fi

log "Waiting for Chromium DevTools (127.0.0.1:9222 inside pod '$POD')"
ok=0
for _ in $(seq 1 30); do
  if pm exec "$CHROME" curl -sf http://127.0.0.1:9222/json/version >/dev/null 2>&1; then ok=1; break; fi
  sleep 1
done
if (( !ok )); then
  echo "Chromium did not come up. Last log lines:" >&2
  pm logs --tail 20 "$CHROME" >&2 || true
  echo "If you see Wayland/permission errors, check: sudo ausearch -m avc -ts recent" >&2
  exit 1
fi
echo "Chromium ready."
if (( PG )); then ensure_postgres; fi
if (( DIND )); then ensure_dind; fi
for p in "${PORTS[@]}"; do echo "Port: http://127.0.0.1:${p%%:*} on the host -> 127.0.0.1:${p#*:} in pod '$POD'"; done

(( NOLAUNCH )) && { log "Setup complete for instance '$ILABEL' (-n: not launching OpenCode)."; exit 0; }

# ---- launch OpenCode ------------------------------------------------------------------
if [[ $(cstate "$AGENT") == running ]]; then
  log "OpenCode is already running in instance '$ILABEL'; setup is up to date (acting like -n)."
  echo "Open a shell in it with:  ${0##*/}${INST:+ -i $INST} -x"
  exit 0
fi
pm rm -f "$AGENT" >/dev/null 2>&1 || true
envargs=(-e "OC_INSTANCE=$ILABEL")
for v in "${FWD_ENV[@]}"; do [[ -n ${!v:-} ]] && envargs+=(-e "$v"); done
if [[ $(cstate "$DINDC") != none ]]; then
  envargs+=(-v "$DINDRUN":/run/dind -e DOCKER_HOST=unix:///run/dind/podman.sock
            -e CONTAINER_HOST=unix:///run/dind/podman.sock)
fi
log "Launching OpenCode (instance '$ILABEL') in /sandbox/$CWD"
# No ':Z' on the shared mounts: relabel_shared already gave them this level (see above).
exec "${H[@]}" podman run -it --rm --name "$AGENT" --pod "$POD" --label oc.sandbox=1 --label "oc.instance=$ILABEL" \
  --cap-drop=ALL --security-opt=no-new-privileges --security-opt "label=level:$LEVEL" \
  --pids-limit=512 --memory="$AGENT_MEM" \
  -v "$SB":/sandbox \
  -v "$HOMEVOL":/root \
  -w "/sandbox/$CWD" \
  "${envargs[@]}" \
  "$AGENT_IMG"
