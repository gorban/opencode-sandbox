# The ledger is only replaced atomically (rename), so a plain read always sees a whole version.
# Every change (append, rewrite) holds an exclusive flock: parallel instances share the ledger.
owned_image() { [[ $1 =~ ^[0-9a-f]{64}$ && -f $IMAGE_LOG ]] && grep -qxF "$1" "$IMAGE_LOG"; }
ledger_locked() {  # command...: run it holding the ledger lock
  local fd rc=0
  exec {fd}>>"$IMAGE_LOG.lock"
  flock "$fd" || { exec {fd}>&-; return 1; }
  "$@" || rc=$?
  exec {fd}>&-
  return $rc
}
_ledger_add() { printf '%s\n' "$1" >> "$IMAGE_LOG"; }
record_image() { [[ $1 =~ ^[0-9a-f]{64}$ ]] && ledger_locked _ledger_add "$1"; }
_prune() {
  [[ -f $IMAGE_LOG ]] || return 0
  local id tags keep=() tmp
  while read -r id; do
    [[ $id =~ ^[0-9a-f]{64}$ ]] || continue
    tags=$(pm image inspect --format '{{len .RepoTags}}' "$id" 2>/dev/null) || continue   # gone
    # Still tagged (current, or retagged by you) or used by a container (rmi without -f refuses): kept.
    if [[ $tags == 0 ]] && pm rmi "$id" >/dev/null 2>&1; then continue; fi
    keep+=("$id")
  done < <(sort -u "$IMAGE_LOG")
  tmp=$(mktemp "$IMAGE_LOG.XXXXXX") || return 1
  if printf '%s\n' ${keep[@]+"${keep[@]}"} > "$tmp" && mv -f "$tmp" "$IMAGE_LOG"; then return 0; fi
  rm -f "$tmp"; return 1
}
prune_images() {  # remove our recorded builds that are now untagged and unused; forget vanished ones
  [[ -f $IMAGE_LOG ]] || return 0
  ledger_locked _prune || echo "warning: could not update $IMAGE_LOG" >&2
}
log() { printf '\033[1m==> %s\033[0m\n' "$*"; }
cstate() { pm container inspect --format '{{.State.Status}}' "$1" 2>/dev/null || echo none; }
pod_relays() {  # pod name -> one relay container name per line (legacy + multi-slot provider-relay)
  local pod=$1 seen=" " c role lines rc=0 ex_rc=0
  pm pod exists "$pod" >/dev/null 2>&1 || rc=$?
  (( rc == 0 || rc == 1 )) || return 1
  if (( rc == 0 )); then
    lines=$(pm pod inspect "$pod" --format '{{range .Containers}}{{.Name}}{{"\n"}}{{end}}' 2>/dev/null) || return 1
    while IFS= read -r c; do
      c=${c#/}
      [[ -n $c ]] || continue
      if ! role=$(pm container inspect --format '{{index .Config.Labels "oc.role"}}' "$c" 2>/dev/null); then
        ex_rc=0
        pm container exists "$c" >/dev/null 2>&1 || ex_rc=$?
        (( ex_rc == 1 )) && continue
        return 1
      fi
      if [[ $c == "$pod-openai-relay" || $c == "$pod-relay-"[0-9]* || $role == provider-relay || $role == openai-relay ]]; then
        [[ $seen == *" $c "* ]] || { seen+="$c "; printf '%s\n' "$c"; }
      fi
    done <<<"$lines"
  fi
  if [[ $seen != *" $pod-openai-relay "* ]]; then
    ex_rc=0
    pm container exists "$pod-openai-relay" >/dev/null 2>&1 || ex_rc=$?
    case $ex_rc in
      0) printf '%s\n' "$pod-openai-relay" ;;
      1) ;;
      *) return 1 ;;
    esac
  fi
}
relay_inspect_id_and_state() {  # container -> "<id> <status> <sandbox> <instance> <role>", rc 3 if absent, 1 on error
  local target=$1 out="" rc=0
  if out=$(pm container inspect --format '{{.Id}} {{.State.Status}} {{index .Config.Labels "oc.sandbox"}} {{index .Config.Labels "oc.instance"}} {{index .Config.Labels "oc.role"}}' "$target" 2>/dev/null); then
    printf '%s\n' "$out"
    return 0
  fi
  pm container exists "$target" >/dev/null 2>&1 || rc=$?
  (( rc == 1 )) && return 3
  return 1
}
any_relay_running() {  # 0 if any relay in $1 is active/paused/restarting/uninspectable, 1 iff positively stopped/absent
  local pod=$1 relays c info cid st rc=0
  relays=$(pod_relays "$pod") || return 0
  while IFS= read -r c; do
    [[ -n $c ]] || continue
    rc=0
    info=$(relay_inspect_id_and_state "$c") || rc=$?
    (( rc == 3 )) && continue
    (( rc == 0 )) || return 0
    read -r cid st _ <<<"$info"
    [[ $cid =~ ^[0-9a-f]{64}$ ]] || return 0
    case $st in
      exited|stopped|created|configured|initialized) ;;
      *) return 0 ;;
    esac
  done <<<"$relays"
  return 1
}
remove_stale_relays() {  # remove positively stopped, owned relay containers in $1 by verified container ID
  local pod=$1 relays c info cid st sbox inst role rc=0
  relays=$(pod_relays "$pod") || return 1
  while IFS= read -r c; do
    [[ -n $c ]] || continue
    rc=0
    info=$(relay_inspect_id_and_state "$c") || rc=$?
    (( rc == 3 )) && continue
    (( rc == 0 )) || return 1
    read -r cid st sbox inst role <<<"$info"
    [[ $cid =~ ^[0-9a-f]{64}$ && $sbox == 1 && $inst == "$ILABEL" ]] || return 1
    [[ $role == provider-relay || $role == openai-relay ]] || return 1
    case $st in
      exited|stopped|created|configured|initialized) ;;
      *) return 1 ;;
    esac
    pm rm -- "$cid" >/dev/null 2>&1 || return 1
  done <<<"$relays"
}

# The helper holds an O_NOFOLLOW, owner/identity-checked flock on a persistent inode.
# Its pipe and parent check release the lock if this shell exits or is killed.
acquire_guard() {  # name, mode; acquire installation, lifecycle, then setup
  local name=$1 mode=$2 line rfd wfd pid helper guard_name=$1 guard_state=$STATE
  if [[ $name == worktree ]]; then guard_state=$WT_DIR; fi
  if [[ $name == installation ]]; then guard_state=$INSTALL_DIR; fi
  (umask 077; mkdir -p "$guard_state")
  helper=$(trusted_file "$SCRIPT_DIR/oc-setup-lock.py") || die "missing or unsafe oc-setup-lock.py"
  coproc OC_LOCK_GUARD { exec /usr/bin/python3 -I "$helper" "$guard_state" "$guard_name" "$mode" "$ILABEL" "$$"; }
  pid=$OC_LOCK_GUARD_PID rfd=${OC_LOCK_GUARD[0]} wfd=${OC_LOCK_GUARD[1]}
  if ! IFS= read -r -u "$rfd" line || [[ $line != LOCKED ]]; then
    exec {wfd}>&-; exec {rfd}<&-; wait "$pid" || true
    die "could not acquire $name lock"
  fi
  exec {rfd}<&-
  if [[ $name == installation ]]; then INSTALL_LOCK_FD=$wfd INSTALL_LOCK_PID=$pid
  elif [[ $name == setup ]]; then SETUP_LOCK_FD=$wfd SETUP_LOCK_PID=$pid
  elif [[ $name == worktree ]]; then WORKTREE_LOCK_FD=$wfd WORKTREE_LOCK_PID=$pid
  else LIFECYCLE_LOCK_FD=$wfd LIFECYCLE_LOCK_PID=$pid; fi
}
release_installation_lock() { exec {INSTALL_LOCK_FD}>&-; wait "$INSTALL_LOCK_PID" || die "installation lock helper failed"; }
release_setup_lock() { exec {SETUP_LOCK_FD}>&-; wait "$SETUP_LOCK_PID" || die "setup lock helper failed"; }
release_lifecycle_lock() { exec {LIFECYCLE_LOCK_FD}>&-; wait "$LIFECYCLE_LOCK_PID" || die "lifecycle lock helper failed"; }
release_worktree_lock() { exec {WORKTREE_LOCK_FD}>&-; wait "$WORKTREE_LOCK_PID" || die "worktree lock helper failed"; }

# Host-owned metadata: directory and records are opened relative to a no-follow
# directory fd, and never trusted if a symlink, hard link or unsafe mode is found.
worktree_state() {  # create | read NAME | drop NAME | write NAME CWD REPO BRANCH
  /usr/bin/python3 -I -c '
import os, re, secrets, stat, sys
state, mode, *args = sys.argv[1:]
def checked_dir(fd, private=False):
    st = os.fstat(fd)
    if st.st_uid != os.geteuid() or (stat.S_IMODE(st.st_mode) != 0o700 if private else st.st_mode & 0o022):
        raise ValueError("unsafe worktree state directory ownership or mode")
def record(fd, name):
    try: f = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
    except FileNotFoundError: return None
    try:
        st = os.fstat(f); named = os.stat(name, dir_fd=fd, follow_symlinks=False)
        if (not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid() or stat.S_IMODE(st.st_mode) != 0o600
            or st.st_nlink != 1 or (st.st_dev, st.st_ino) != (named.st_dev, named.st_ino) or st.st_size > 4096):
            raise ValueError("unsafe worktree record ownership, mode, links or identity")
        data = os.read(f, 4097)
        if len(data) != st.st_size: raise ValueError("worktree record changed while reading")
        return data
    finally: os.close(f)
try:
    try: root = os.open(state, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except FileNotFoundError:
        if mode == "read": sys.exit(3)
        if mode == "drop": sys.exit(0)
        raise
    checked_dir(root)
    if mode == "create":
        try: os.mkdir("worktrees", 0o700, dir_fd=root)
        except FileExistsError: pass
    try: directory = os.open("worktrees", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=root)
    except FileNotFoundError:
        if mode == "read": sys.exit(3)
        if mode == "drop": sys.exit(0)
        raise
    checked_dir(directory, True)
    if mode == "create": sys.exit(0)
    name = args[0]
    if not re.fullmatch(r"[a-z0-9-]+", name): raise ValueError("invalid worktree record name")
    existing = record(directory, name)
    if mode == "read":
        if existing is None: sys.exit(3)
        sys.stdout.buffer.write(existing)
    elif mode == "drop":
        if existing is not None: os.unlink(name, dir_fd=directory)
    elif mode == "write":
        if len(args) != 4: raise ValueError("invalid worktree record")
        data = ("\n".join(args[1:]) + "\n").encode()
        tmp = ".record." + secrets.token_hex(16)
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=directory)
        try:
            with os.fdopen(fd, "wb") as f: f.write(data)
            os.replace(tmp, name, src_dir_fd=directory, dst_dir_fd=directory)
        finally:
            try: os.unlink(tmp, dir_fd=directory)
            except FileNotFoundError: pass
    else: raise ValueError("invalid worktree state operation")
except (OSError, ValueError) as exc:
    print("unsafe worktree state: " + str(exc), file=sys.stderr)
    sys.exit(2)
' "$STATE" "$@"
}
# ---- ports ----------------------------------------------------------------------------------------
PORTS=() PORTS_SET=0
parse_ports() {  # PORT_ARGS -> PORTS ("HOST:POD"), refusing unsafe or impossible mappings
  local a it h c s seen=" " low items
  low=$("${H[@]}" cat /proc/sys/net/ipv4/ip_unprivileged_port_start 2>/dev/null || echo 1024)
  for a in "${PORT_ARGS[@]}"; do
    PORTS_SET=1
    if [[ $a == none ]]; then PORTS=(); continue; fi
    IFS=, read -ra items <<<"$a"
    for it in "${items[@]}"; do
      [[ $it =~ ^([0-9]{1,5})(:([0-9]{1,5}))?$ ]] || die "-P: '$it' is not PORT or HOSTPORT:PODPORT"
      h=$((10#${BASH_REMATCH[1]})); c=$h
      [[ -z ${BASH_REMATCH[3]:-} ]] || c=$((10#${BASH_REMATCH[3]}))
      (( h >= 1 && h <= 65535 && c >= 1 && c <= 65535 )) || die "-P: '$it': ports are 1-65535"
      (( h >= low )) || die "-P: host port $h is below $low, which rootless Podman cannot bind; use e.g. $((h + 8000)):$c (the pod side may be any port)"
      for s in "${SENSITIVE_PORTS[@]}"; do
        (( c != s )) || die "-P: refusing to publish pod port $c: Chromium DevTools / provider relay trusts localhost"
      done
      (( c != 5432 || PG )) || die "-P: refusing to publish pod port 5432 without -p (Postgres authentication is required)"
      [[ $seen != *" $h "* ]] || die "-P: host port $h given twice"
      seen+="$h "; PORTS+=("$h:$c")
    done
  done
}
parse_ports
ports_label() { local IFS=,; printf '%s' "${PORTS[*]}"; }

# FIDO/U2F security keys: hidraw nodes whose HID usage page is 0xF1D0 (never keyboards/mice).
# Prints one line per key: /dev/hidrawN|Manufacturer Product|vid:pid
detect_keys() {
  "${H[@]}" sh -c 'display_field() { LC_ALL=C tr -cd " -~" < "$1" | LC_ALL=C tr -d "|"; }
  for h in /sys/class/hidraw/hidraw*; do
    node=${h##*/}
    case ${node#hidraw} in ""|*[!0-9]*) continue ;; esac
    [ -r "$h/device/report_descriptor" ] || continue
    [ "$(head -c3 "$h/device/report_descriptor" | od -An -tx1 | tr -d " \n")" = 06d0f1 ] || continue
    u=$(readlink -f "$h/device")/../..
    printf "%s|%s %s|%s:%s\n" "/dev/$node" "$(display_field "$u/manufacturer" 2>/dev/null)" \
      "$(display_field "$u/product" 2>/dev/null)" "$(display_field "$u/idVendor" 2>/dev/null)" "$(display_field "$u/idProduct" 2>/dev/null)"
  done; true' 2>/dev/null || true
}
fido_device_nodes() {
  local node rest
  while IFS='|' read -r node rest; do
    if [[ $node =~ ^/dev/hidraw[0-9]+$ ]]; then printf '%s\n' "$node"; fi
  done
}

# Pods of all instances: labelled ones, plus the default pod made by versions before labels existed.
instance_pods() {
  local pods rc=0
  pods=$(pm pod ls --filter label=oc.sandbox=1 --format '{{.Name}}') || return 1
  pm pod exists oc || rc=$?
  case $rc in
    0) pods+=$'\noc' ;;
    1) ;;
    *) return 1 ;;
  esac
  if [[ -n $pods ]]; then printf '%s\n' "$pods" | sort -u | sed '/^$/d'; fi
}

if (( LIST )); then
  pods=$(instance_pods) || die "could not list instance pods"
  printf '%-14s %-10s %-8s %-22s %-24s %s\n' INSTANCE POD AGENT PORTS "WORKING DIR" SIDECARS
  while read -r pod; do
    [[ -n $pod ]] || continue
    if [[ $pod == oc ]]; then inst=default INST=""; else inst=${pod#oc-} INST=${pod#oc-}; fi
    set_names
    ports=$(pm pod inspect "$pod" --format '{{index .Labels "oc.ports"}}' 2>/dev/null || true)
    wd=$(pm container inspect --format '{{.Config.WorkingDir}}' "$AGENT" 2>/dev/null || true)
    side=""
    for c in "$CHROME" "$PGC" "$DINDC"; do
      s=$(cstate "$c"); [[ $s == none ]] || side+="${c#"$POD"-}:$s "
    done
    relays=$(pod_relays "$POD" 2>/dev/null || true)
    while IFS= read -r c; do
      [[ -n $c ]] || continue
      s=$(cstate "$c"); [[ $s == none ]] || side+="${c#"$POD"-}:$s "
    done <<<"$relays"
    wt_info=""
    record_rc=0
    record=$(worktree_state read "$inst") || record_rc=$?
    (( record_rc == 0 || record_rc == 3 )) || die "unsafe worktree record for $inst"
    if (( record_rc == 0 )); then
      { IFS= read -r _; IFS= read -r repo; IFS= read -r branch; } <<<"$record" || die "invalid worktree record for $inst"
      valid_relpath "$repo" && [[ $branch =~ ^[A-Za-z0-9._/@+-]+$ ]] || die "invalid worktree record for $inst"
      wt_info=" worktree:$repo:$branch"
    elif [[ $wd == /sandbox/* && -f $STATE/sb-level ]] && valid_relpath "${wd#/sandbox/}"; then
      LEVEL=$(< "$STATE/sb-level")
      info=""
      if [[ $LEVEL =~ ^s0:c[0-9]+,c[0-9]+$ ]]; then info=$(tree_run info "${wd#/sandbox/}" 2>/dev/null) || info=""; fi
      if [[ $info =~ ^[A-Za-z0-9._@+/-]+:[A-Za-z0-9._/@+-]+$ ]]; then wt_info=" worktree:$info"; fi
    fi
    printf '%-14s %-10s %-8s %-22s %-24s %s%s\n' "$inst" "$pod" "$(cstate "$AGENT")" \
      "$(sed 's/:/->/g' <<<"${ports:--}")" "${wd:--}" "${side:--}" "$wt_info"
  done <<<"$pods"
  exit 0
fi
if (( EXEC )); then
  [[ $(cstate "$AGENT") == running ]] \
    || { echo "OpenCode is not running in instance '$ILABEL'. Start it first (${0##*/}${INST:+ -i $INST}) in another terminal." >&2; exit 1; }
  wd=$(pm container inspect --format '{{.Config.WorkingDir}}' "$AGENT")
  exec "${H[@]}" podman exec -it -e SHELL=/bin/zsh -w "${wd:-/sandbox}" "$AGENT" zsh
fi
if (( LISTKEYS )); then
  keys=$(detect_keys)
  if [[ -z $keys ]]; then echo "No FIDO/U2F security keys detected."; exit 0; fi
  echo "Detected FIDO/U2F security keys (passed to Chromium unless -K):"
  while IFS='|' read -r node name id; do printf '  %-14s %s [%s]\n' "$node" "$name" "$id"; done <<<"$keys"
  exit 0
fi

# ---- Postgres settings: NO defaults; must be configured (see README.md) ---------------------------
# Read from OC_PG_* env vars or ~/.config/oc-sandbox/postgres.env (postgres.NAME.env for instance NAME
# if it exists; KEY=VALUE lines; env wins). These files live OUTSIDE the sandbox, so the agent cannot
# change which image/credentials get used.
#   OC_PG_IMAGE     image to run                       (required)
#   OC_PG_USER      superuser created on first start   (required)
#   OC_PG_PASSWORD  its password                       (required)
#   OC_PG_DB        initial database                   (required)
#   OC_PG_INIT_DIR  dir of *.sql/*.sh run once when the data volume is first created
#                   (optional; default ~/.config/oc-sandbox/postgres-init if it exists)
load_pg_config() {
  local k v line missing=() cdir=$CONF_DIR
  PG_CONF=$cdir/postgres.env
  [[ -n $INST && -f $cdir/postgres.$INST.env ]] && PG_CONF=$cdir/postgres.$INST.env
  PG_CONF=${OC_PG_CONF:-$PG_CONF}
  [[ $PG_CONF == /* ]] || PG_CONF="$CALLER_PHYSICAL/$PG_CONF"
  PG_CONF=$(trusted_path "$PG_CONF") || die "refusing sandbox-controlled Postgres configuration"
  if [[ -f $PG_CONF ]]; then
    # KEY=VALUE lines (optional 'export ', spaces around '=' allowed). A quoted value is taken
    # literally; an unquoted one ends at whitespace followed by '#' (an inline comment).
    while IFS= read -r line || [[ -n $line ]]; do
      line=${line%$'\r'}
      [[ $line =~ ^[[:space:]]*(export[[:space:]]+)?(OC_PG_[A-Z_]+)[[:space:]]*=[[:space:]]*(.*)$ ]] || continue
      k=${BASH_REMATCH[2]} v=${BASH_REMATCH[3]}
      [[ -z ${!k:-} ]] || continue                     # environment wins over the file
      if [[ $v =~ ^\"([^\"]*)\"[[:space:]]*(#.*)?$ || $v =~ ^\'([^\']*)\'[[:space:]]*(#.*)?$ ]]; then
        v=${BASH_REMATCH[1]}
      else
        v=${v%%[[:space:]]#*}
        v=${v%"${v##*[![:space:]]}"}                   # trailing whitespace
      fi
      printf -v "$k" '%s' "$v"                         # a plain shell variable, NOT exported
    done < "$PG_CONF"
  fi
  # Values that came from the environment are un-exported too, so no child process (podman,
  # distrobox-host-exec, the agent) inherits the password. It reaches Postgres only as a secret.
  # shellcheck disable=SC2163  # un-exporting the variable NAMED by $k is the point
  for k in "${!OC_PG_@}"; do export -n "$k"; done
  for k in OC_PG_IMAGE OC_PG_USER OC_PG_PASSWORD OC_PG_DB; do
    [[ -n ${!k:-} ]] || missing+=("$k")
  done
  if (( ${#missing[@]} )); then
    echo "Postgres is not configured (missing: ${missing[*]})." >&2
    echo "There are deliberately no defaults. Create $PG_CONF" >&2
    echo "or set those variables; see \"Postgres configuration\" in $SCRIPT_DIR/README.md" >&2
    exit 1
  fi
  PG_IMAGE=$OC_PG_IMAGE PG_USER=$OC_PG_USER PG_PASSWORD=$OC_PG_PASSWORD PG_DB=$OC_PG_DB
  # Assignment preserves an inherited export flag; never export the copied password.
  export -n PG_PASSWORD
  # libpq's line-oriented password-file format cannot represent a newline or CR.
  for v in "$PG_USER" "$PG_PASSWORD" "$PG_DB"; do
    [[ $v != *$'\n'* && $v != *$'\r'* ]] || die "Postgres user, password and database must not contain newlines"
  done
  PG_INIT=${OC_PG_INIT_DIR:-$cdir/postgres-init}
  [[ $PG_INIT == /* ]] || PG_INIT="$CALLER_PWD/$PG_INIT"
  PG_INIT=$(host_input postgres-path "$PG_INIT") || die "refusing unsafe host Postgres init directory"
}

# ---- teardown -----------------------------------------------------------------
unit_env() {
  [[ $2 != *$'\n'* && $2 != *$'\r'* ]] || die "invalid line break in $1"
  local v=${2//%/%%}
  v=${v//\\/\\\\}; printf 'Environment="%s=%s"\n' "$1" "${v//\"/\\\"}"
}

has_unlabelled_instance_resources() {
  local name pods=$1 volumes=$2
  while IFS= read -r name; do
    if [[ $name == oc ]] || { [[ $name == oc-* ]] && valid_instance "${name#oc-}"; }; then
      return 0
    fi
  done <<<"$pods"
  while IFS= read -r name; do
    case $name in oc-home|oc-chrome|oc-pg|oc-dind|oc-dind-run|oc-openai-home) return 0;; esac
    if [[ $name =~ ^oc-(.+)-(chrome|pg|dind|dind-run|openai-home)$ ]] && valid_instance "${BASH_REMATCH[1]}"; then
      return 0
    fi
  done <<<"$volumes"
  return 1
}

require_empty_installation() {
  local managed_pods pods managed_volumes volumes secrets
  managed_pods=$(pm pod ls --filter label=oc.sandbox=1 --format '{{.Name}}') \
    || die "could not verify managed pod inventory"
  pods=$(pm pod ls --format '{{.Name}}') || die "could not verify installation pod inventory"
  managed_volumes=$(pm volume ls -q --filter label=oc.sandbox=1) || die "could not verify managed volume inventory"
  volumes=$(pm volume ls -q) || die "could not verify legacy volume inventory"
  secrets=$(pm secret ls --format '{{.Name}}') || die "could not verify installation secret inventory"
  # Named teardown can also remove these resources when they have no labels.
  if [[ -n $managed_pods || -n $managed_volumes ]] ||
      has_unlabelled_instance_resources "$pods" "$volumes" ||
      grep -qxE 'oc(-[a-z0-9-]+)?-pg-(password|passfile|hba)' <<<"$secrets"; then
    die "legacy sandbox resources remain without an installation binding; recover the original data root before setup or teardown"
  fi
}

bind_installation() {
  local installed="$UNITS/oc-bridge.service" receipt="$INSTALL_DIR/binding" host_state current expected
  shared_host_directory "$UNITS" 'systemd user' "$UNITS_SOURCE" >/dev/null || return 1
  shared_host_directory "$INSTALL_DIR" 'installation binding' "$UNITS_SOURCE/.oc-sandbox" >/dev/null || return 1
  host_state=$(shared_host_directory "$STATE" 'installation state') || return 1
  expected=$(printf '%s\n%s\n' "$host_state" "$HOST_BRIDGE_STAGE")
  acquire_guard installation exclusive
  validate_host_state || die "refusing unsafe installation binding"
  if [[ -e $receipt ]]; then
    current=$(< "$receipt") || die "could not read installation binding"
    [[ $current == "$expected" ]] || die "installed state or bridge stage differs; use the original XDG_DATA_HOME"
    return 0
  fi
  if [[ -f $installed ]]; then
    # Adopt only a matching legacy unit. Leave it intact on ambiguity.
    [[ $(grep -c '^Environment="OC_BRIDGE_STAGE=' "$installed") == 1 ]] &&
      grep -qxF -e "$(unit_env OC_BRIDGE_STAGE "$HOST_BRIDGE_STAGE")" \
        -e "$(unit_env OC_BRIDGE_STAGE "$BRIDGE_STAGE")" -- "$installed" \
      || die "installed bridge stage differs; use the original XDG_DATA_HOME"
  else
    require_empty_installation
  fi
  printf '%s\n' "$expected" | atomic_host_file "$receipt" 0600 || die "could not record installation binding"
}

confirm() { (( YES )) && return 0; read -r -p "$1 [y/N] " a; [[ $a == [yY]* ]]; }
remove_pod() {
  local rc=0
  pm pod rm --ignore -f -- "$1" >/dev/null || return 1
  pm pod exists "$1" || rc=$?
  (( rc == 1 ))
}
remove_instance_storage() {
  local kind=$1 name=$2 rc=0
  shift 2
  pm "$kind" exists "$name" || rc=$?
  case $rc in
    1) return 0 ;;
    0) ;;
    *) return 1 ;;
  esac
  pm "$kind" rm "$@" "$name" >/dev/null || return 1
  rc=0
  pm "$kind" exists "$name" || rc=$?
  (( rc == 1 ))
}
bridge_unit_state() {
  local output
  local -a fields
  output=$(sc show --property=LoadState --property=ActiveState --property=Job "$1") || return 1
  readarray -t fields <<<"$output"
  [[ ${#fields[@]} == 3 && ${fields[0]} =~ ^LoadState=(loaded|not-found)$ &&
     ${fields[1]} =~ ^ActiveState=(active|inactive|failed|activating|deactivating|reloading|maintenance|refreshing)$ &&
     ${fields[2]} =~ ^Job=[0-9]*$ ]] || return 1
  printf '%s\n' "$output"
}
stop_bridge() {
  local unit state
  for unit in oc-bridge.timer oc-bridge.path oc-bridge.service; do
    sc stop "$unit" >/dev/null 2>&1 || true
    state=$(bridge_unit_state "$unit") || return 1
    [[ $state == *$'\nActiveState=inactive\nJob=' || $state == *$'\nActiveState=failed\nJob=' ]] || return 1
  done
}
require_empty_bridge_stage() {
  local staged
  [[ -d $BRIDGE_STAGE ]] || return 0
  staged=$(find "$BRIDGE_STAGE" -mindepth 1 -maxdepth 1 -printf x -quit) \
    || die "could not inspect staged editor sessions"
  [[ -z $staged ]] || die "staged editor sessions remain in $BRIDGE_STAGE; close editors or recover their files and retry"
}
disable_bridge_trigger() {
  local unit=$1
  if [[ -f $UNITS/$unit ]]; then sc disable "$unit" >/dev/null || return 1; fi
}
quiesce_bridge_installation() {
  local legacy timer
  validate_host_state || die "refusing unsafe host bridge installation"
  legacy=$(bridge_unit_state oc-bridge.path) || die "could not inspect the legacy host bridge"
  timer=$(bridge_unit_state oc-bridge.timer) || die "could not inspect the host bridge timer"
  stop_bridge || die "could not quiesce the host bridge before replacement"
  if [[ -f $UNITS/oc-bridge.path || $legacy == $'LoadState=loaded\n'* ]]; then
    require_empty_bridge_stage
    sc disable oc-bridge.path >/dev/null || die "could not disable the legacy host bridge"
    rm -f -- "$UNITS/oc-bridge.path" || die "could not remove the legacy host bridge"
  fi
  if [[ -f $UNITS/oc-bridge.timer || -L $UNITS/default.target.wants/oc-bridge.timer ||
        $timer == $'LoadState=loaded\n'* ]]; then
    sc disable oc-bridge.timer >/dev/null || die "could not disarm the host bridge timer"
  fi
}
# The module is installed by semodule at its default priority (400). A lower-priority
# module with the same name belongs to someone else and must not be removed.
remove_chromium_policy() {
  local modules admin="" priority name rest present=0
  if ! modules=$("${H[@]}" semodule -lfull 2>/dev/null); then
    # Some hosts allow unprivileged listing; on others the module store is private.
    # Choose the escalation method once: a failed authorization or semodule call is
    # an error, not evidence that a different authenticator should be tried.
    if "${H[@]}" sh -c 'command -v pkexec >/dev/null 2>&1'; then admin=pkexec; else admin=sudo; fi
    if ! modules=$("${H[@]}" "$admin" semodule -lfull); then
      echo "error: could not list SELinux modules; oc_chromium may still be installed" >&2
      return 1
    fi
  fi
  while read -r priority name rest; do
    if [[ $priority == 400 && $name == oc_chromium ]]; then present=1; break; fi
  done <<<"$modules"
  (( present )) || return 0
  if [[ -z $admin ]]; then
    if "${H[@]}" sh -c 'command -v pkexec >/dev/null 2>&1'; then admin=pkexec; else admin=sudo; fi
  fi
  log "Removing SELinux module oc_chromium at priority 400 (asks for your admin password)"
  if ! "${H[@]}" "$admin" semodule -X 400 -r oc_chromium; then
    echo "error: could not remove SELinux module oc_chromium at priority 400" >&2
    return 1
  fi
}
if (( DELETE )); then
  verify_bridge_stage
  bind_installation
  acquire_guard lifecycle exclusive
  if (( INST_SET )); then                                   # one instance only (also -i default)
    log "Removing instance '$ILABEL' (pod $POD)"
    remove_pod "$POD" || die "could not verify that pod '$POD' was removed"
    if (( ALL )); then
      if confirm "Also delete volumes $CHROMEVOL $PGVOL $DINDVOL $DINDRUN $OPENAI_HOMEVOL (Chromium profile, Postgres data, docker storage, provider home)?"; then
        purge_failed=0
        for v in "$CHROMEVOL" "$PGVOL" "$DINDVOL" "$DINDRUN" "$OPENAI_HOMEVOL"; do
          remove_instance_storage volume "$v" -f || { echo "could not verify removal of volume '$v'" >&2; purge_failed=1; }
        done
        for s in "$PGSECRET" "$PGPASSSECRET" "$PGHBASECRET"; do
          remove_instance_storage secret "$s" || { echo "could not verify removal of secret '$s'" >&2; purge_failed=1; }
        done
        (( purge_failed == 0 )) || die "instance storage cleanup incomplete; worktree selection retained"
        worktree_state drop "$ILABEL" || die "could not clear the worktree selection for '$ILABEL'"
      else echo "Skipped -a part."; fi
    fi
    log "Done. $SB/$DEFAULT_CWD (and any other files in $SB) left untouched."
    exit 0
  fi
  # Global teardown shares the persistent setup lock and must never unlink it.
  acquire_guard setup exclusive
  if compgen -G "$STATE/opencode-update.*" >/dev/null; then
    die "unresolved OpenCode updater receipts in $STATE; inspect and clean the recorded container IDs before teardown"
  fi
  stop_bridge || die "could not confirm the host bridge stopped"
  require_empty_bridge_stage
  pods=$(instance_pods) || die "could not list instance pods; teardown stopped"
  while IFS= read -r pod; do
    [[ -n $pod ]] || continue
    log "Removing pod '$pod'"
    remove_pod "$pod" || die "could not verify that pod '$pod' was removed"
  done <<<"$pods"
  pods=$(instance_pods) || die "could not verify that all instance pods were removed"
  [[ -z $pods ]] || die "instance pods remain; teardown stopped"
  log "Removing host bridge"
  disable_bridge_trigger oc-bridge.path || die "could not disable the legacy host bridge"
  disable_bridge_trigger oc-bridge.timer || die "could not disable the host bridge timer"
  rm -f -- "$UNITS/oc-bridge.path" "$UNITS/oc-bridge.timer" "$UNITS/oc-bridge.service" "$BIN/oc-bridge"
  sc daemon-reload >/dev/null || die "could not reload the user service manager"
  if (( ALL )); then
    if ! confirm "Also delete ALL oc-sandbox volumes (OpenCode login, Chromium profiles, Postgres data, docker storage), images and build files?"; then
      echo "Skipped -a part."; exit 0
    fi
    log "Removing images, volumes, secrets, build files"
    # Only images this script built: drop our tag from them (not other tags you gave them), then
    # remove every recorded build that is untagged and unused. Never -f, never by tag alone.
    for img in "$AGENT_IMG" "$CHROME_IMG" "$RELAY_IMG"; do
      id=$(pm image inspect --format '{{.Id}}' "$img" 2>/dev/null || true)
      if owned_image "$id"; then pm untag "$id" "localhost/$img:latest" >/dev/null 2>&1 || true
      elif [[ -n $id ]]; then echo "note: kept image '$img' (${id:0:12}): not built by this oc-sandbox installation" >&2; fi
    done
    prune_images
    mapfile -t vols < <({ pm volume ls -q --filter label=oc.sandbox=1; printf '%s\n' "$HOMEVOL" oc-chrome oc-pg; } | sort -u)
    for v in "${vols[@]}"; do pm volume rm -f "$v" >/dev/null 2>&1 || true; done
    # No matching secret (never used -p) is normal; failing to list them only warns, so the rest of
    # the cleanup (SELinux module, state, .bridge) still runs.
    if secrets=$(pm secret ls --format '{{.Name}}' 2>/dev/null); then
      while read -r s; do
        if [[ $s =~ ^oc(-[a-z0-9-]+)?-pg-(password|passfile|hba)$ ]]; then pm secret rm "$s" >/dev/null 2>&1 || true; fi
      done <<<"$secrets"
    else echo "warning: could not list Podman secrets; remove any oc-*-pg-password secrets by hand" >&2; fi
    teardown_status=0
    remove_chromium_policy || teardown_status=1
    # We verified that the pods are gone and stopped the bridge path and service above.
    # GNU rm -r unlinks symlinks instead of traversing their targets.
    if (( teardown_status == 0 )); then
      # Keep setup.lock's inode permanently, including across global teardown.
      find "$STATE" -mindepth 1 -maxdepth 1 ! -name setup.lock ! -name lifecycle.lock -exec rm -rf -- {} +
      rm -rf "$SB/.bridge"
      rm -f "$INSTALL_DIR/binding"
    fi
    if (( teardown_status != 0 )); then
      echo "Cleanup incomplete; state retained at $STATE. Fix the SELinux error and retry." >&2
      exit 1
    fi
  fi
  log "Done. Your files in $SB left untouched."
  exit 0
fi

