; SELinux type for the sandboxed Chromium container only (oc_chromium.process).
(block oc_chromium
    (blockinherit container)
    (blockinherit net_container)
    (allow process process (capability (dac_override)))
    ; use the host Wayland compositor socket (KWin runs unconfined_t)
    (allow process unconfined_t (unix_stream_socket (connectto)))
    (allow process unconfined_t (fd (use)))
    (allow process user_tmp_t (sock_file (write getattr append open)))
    ; shared-memory buffers passed over the Wayland socket
