# ---- images (rebuilt only when inputs change, or with -r) -------------------------
ensure_image() {  # name containerfile hash role(agent|chromium)
  local name=$1 file=$2 want=$3 role=$4 cur="" id="" hash="" new
  cur=$(pm image inspect --format '{{.Id}} {{index .Labels "oc.hash"}}' "$name" 2>/dev/null || true)
  read -r id hash <<<"$cur" || true
  if (( REBUILD )) || [[ $hash != "$want" ]] || ! owned_image "$id"; then
    log "Building $name"
    pm build "${PULL[@]}" --label "$OWNER_LABEL=$role" --label "oc.hash=$want" -t "$name" \
       -f "$BUILD/$file" "$BUILD"
    new=$(pm image inspect --format '{{.Id}}' "$name")
    # The build moved the tag to the new image and left the previous one untagged. prune_images
    # removes it if this script built it; anything else that had the tag is only untagged, never removed.
    if [[ -n $id && $id != "$new" ]] && ! owned_image "$id"; then
      echo "note: image '$name' (${id:0:12}) was not built by this oc-sandbox installation (another tool's" \
           "image, or from an older version); the build untagged it but kept it. Remove it yourself if you" \
           "do not need it: podman rmi ${id:0:12}" >&2
    fi
    record_image "$new"
    prune_images   # a previous build still used by a container (e.g. a running agent) stays for later
  else
    echo "image $name up to date"
  fi
}
