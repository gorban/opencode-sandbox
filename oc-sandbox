        admin_fd = open_dir(admin_path[len("/sandbox/"):])
        reverse_fd = open_control(admin_fd, "gitdir")
        reverse_snapshot = snapshot_file(reverse_fd)
        reverse_link = os.fsdecode(reverse_snapshot[1]).strip()
        destination = "/sandbox/" + dest + "/.git"
        if reverse_link not in (destination, os.path.relpath(destination, admin_path)):
            fail("worktree administrative link does not point back")
        common_file = open_control(admin_fd, "commondir")
        common_snapshot = snapshot_file(common_file)
        common_relative = os.fsdecode(common_snapshot[1]).strip()
        if common_relative != "../..": fail("invalid worktree common directory")
        target_fd = os.open(common_relative, os.O_RDONLY | os.O_DIRECTORY, dir_fd=admin_fd)
        source_stat, target_stat = os.fstat(git_fd), os.fstat(target_fd)
        os.close(target_fd)
        b = git("-C", ".", "symbolic-ref", "--quiet", "--short", "HEAD", check=False, cwd_fd=dest_fd, git_fd=admin_fd)
        same(admin_fd, admin_path[len("/sandbox/"):])
        verify_file(common_file, admin_fd, "commondir", common_snapshot)
        verify_file(reverse_fd, admin_fd, "gitdir", reverse_snapshot)
        verify_file(dot_fd, dest_fd, ".git", dot_snapshot)
        os.close(reverse_fd); os.close(common_file); os.close(dot_fd); os.close(admin_fd)
        if ((source_stat.st_dev, source_stat.st_ino) != (target_stat.st_dev, target_stat.st_ino)
