# The agent can replace anything inside $SB (e.g. construct/ or .bridge/ with a symlink to a host
# directory) at any moment, so the host never creates, writes, relabels or runs git on paths in it.
# Throwaway containers that see ONLY $SB (at /sandbox) do it instead: a symlink there resolves inside
# that container's own filesystem, so whatever it points to, nothing outside $SB can be reached, and
# no check-then-use race exists to win. label=disable avoids relabelling $SB while agents run; these
# containers have no network, no capabilities (FOWNER for relabelling only) and run fixed commands.

RELABEL_PY='import os, sys
ctx = sys.argv[1].encode(); bad = 0
def lab(p):
    global bad
    try:
        if os.getxattr(p, "security.selinux", follow_symlinks=False).rstrip(b"\0") != ctx:
            os.setxattr(p, "security.selinux", ctx, follow_symlinks=False)
    except OSError:
        bad += 1
for top in sys.argv[2:]:
    lab(top)
    for root, dirs, files in os.walk(top):          # never follows symlinks; labels the links themselves
        for x in dirs + files:
            lab(os.path.join(root, x))
if bad:
    print(f"relabel: {bad} entries could not be relabelled (agents may not be able to use them)", file=sys.stderr)'
relabel_shared() {  # give $SB and the shared home volume the agents' level (inside a container)
  safe_run --cap-add=FOWNER -v "$HOMEVOL":/home-vol --entrypoint python3 "$AGENT_IMG" \
    -I -c "$RELABEL_PY" "system_u:object_r:container_file_t:$LEVEL" /sandbox /home-vol
}

# Open every per-instance directory component without following symlinks. The proc-fd
# path anchors the walk to that opened directory even if an agent renames it later.
RELABEL_CWD_PY='import os, sys
ctx = sys.argv[1].encode(); parts = sys.argv[2].split("/"); fds = []; bad = 0
try:
    fds.append(os.open("/sandbox", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW))
    for part in parts:
        if part in ("", ".", ".."): raise ValueError("invalid directory component")
        fds.append(os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fds[-1]))
    try:
        if os.getxattr(fds[-1], "security.selinux").rstrip(b"\0") != ctx:
            os.setxattr(fds[-1], "security.selinux", ctx)
    except OSError: bad += 1
    for root, dirs, files in os.walk("/proc/self/fd/" + str(fds[-1]), followlinks=False):
        for name in dirs + files:
            path = os.path.join(root, name)
            try:
                if os.getxattr(path, "security.selinux", follow_symlinks=False).rstrip(b"\0") != ctx:
                    os.setxattr(path, "security.selinux", ctx, follow_symlinks=False)
            except OSError: bad += 1
    if bad: print(f"relabel: {bad} entries could not be relabelled", file=sys.stderr)
except (OSError, ValueError) as exc:
    print(f"relabel: unsafe instance directory: {exc}", file=sys.stderr); bad += 1
finally:
    for fd in reversed(fds): os.close(fd)
sys.exit(bool(bad))'

