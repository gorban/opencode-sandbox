{
  "name": "oc-sandbox-m3a-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "scripts": {
    "build": "vite build && node scripts/csp.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
