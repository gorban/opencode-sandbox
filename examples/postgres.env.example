# Copy to ~/.config/oc-sandbox/postgres.env  (outside ~/opencode-sandbox, so the agent cannot edit it).
# All four are REQUIRED for `oc-sandbox -p`; there are no defaults. Lines are KEY=VALUE, no `export`.
# Environment variables of the same name take precedence over this file.

# Any Postgres image that honors POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
# (the official image, or your own build, for example one that bundles extensions).
OC_PG_IMAGE=docker.io/library/postgres:17

# Superuser created the first time the data volume is initialised.
OC_PG_USER=app_owner

# Throwaway credentials: the agent in the sandbox can read everything in this database.
OC_PG_PASSWORD=change-me

# Initial database.
OC_PG_DB=app_dev

# Optional: directory of *.sql / *.sh run once when the data volume is first created.
# Default: ~/.config/oc-sandbox/postgres-init (used only if it exists and is not empty).
#OC_PG_INIT_DIR=/path/to/init-scripts
